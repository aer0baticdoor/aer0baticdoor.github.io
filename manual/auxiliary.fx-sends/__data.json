,552,555,558,561,564,567],{"id":496,"title":497},"howto.get-started","Get started — a first project",{"id":499,"title":500},"howto.first-drum-beat","Program a first drum beat",{"id":502,"title":503},"howto.first-bassline","Record a bassline live",{"id":505,"title":506},"howto.first-chords","Add chords on steps",{"id":508,"title":509},"howto.first-punch-in","Perform with punch-in FX",{"id":511,"title":512},"howto.enable-velocity","Make the keyboard velocity-sensitive",{"id":514,"title":515},"howto.control-synth-midi","Play an external synth over MIDI",{"id":517,"title":518},"howto.control-cv-synth","Play an analog synth with CV and gate",{"id":520,"title":521},"howto.sync-drum-machine","Sync a vintage drum machine",{"id":523,"title":524},"howto.sync-pocket-operator","Sync a pocket operator",{"id":526,"title":527},"howto.external-effect","Loop an external effect pedal",{"id":529,"title":530},"howto.midi-keyboard","Play the OP-XY from a MIDI keyboard",{"id":532,"title":533},"howto.audio-interface","Use an audio interface with the OP-XY",{"id":535,"title":536},"howto.pitchbend-modulation","Use the pitchbend strip as a modulator",{"id":538,"title":539},"howto.back-up-projects","Back up projects to a computer",{"id":541,"title":542},"howto.load-samples","Load samples from a computer",{"id":544,"title":545},"howto.song-with-brain","Sketch a song fast with the brain",{"id":547,"title":548},"howto.song-from-scenes","Build a song from scenes",{"id":550,"title":551},"howto.loop-one-scene","Loop one scene",{"id":553,"title":554},"howto.sidechain-duck","Make a track pump with the kick (duck)",{"id":556,"title":557},"howto.pluck","Turn a sound into a pluck",{"id":559,"title":560},"howto.pad-swell","A pad that swells in and fades slowly",{"id":562,"title":563},"howto.wobble","A filter wobble in time with the beat",{"id":565,"title":566},"howto.acid-bass","A squelchy acid bass",{"id":568,"title":569},"howto.slice-a-loop","Sample a loop and play it in slices"],"uses":{}},{"type":"data","data":[{"unit":1,"title":3,"area":89,"prev":91,"next":94,"titles":96,"firmware":63},{"id":2,"title":3,"aliases":4,"area":9,"order":10,"path":11,"context":12,"summary":15,"status":16,"firmware":17,"facts":22,"procedures":72,"parameters":73,"related":74,"body":78,"sources":79,"official_url":26,"controls":88},"auxiliary.fx-sends","FX I and FX II send tracks",[5,6,7,8],"send effects","fx tracks","reverb send","delay send","auxiliary",70,"knowledge/manual/units/auxiliary/fx-sends.md",{"modes":13,"screens":14},[9],[],"`T7` and `T8` hold the two send effects: any sounding track can feed them, FX I can feed FX II (one way only), and `shift + T7` or `shift + T8` opens the effect list for a slot.","current",{"min":18,"changed_in":19,"guide_version":20,"verified_on":21},"1.0.9",[],"1.1.15",null,[23,28,31,35,38,41,45,49,53,57,60,65,68],{"id":24,"text":25,"source":26,"firmware_min":21,"verified_on":21,"confidence":27},"what","FX I and FX II are the two send effects; every track that makes sound can send to both, and FX I can send on into FX II.","https://teenage.engineering/guides/op-xy/auxiliary#fx-i-and-fx-ii","official",{"id":29,"text":30,"source":26,"firmware_min":21,"verified_on":21,"confidence":27},"audition","On an FX track the keyboard plays the last selected instrument track, so you hear the effect on that sound.",{"id":32,"text":33,"source":34,"firmware_min":21,"verified_on":21,"confidence":27},"choose","`shift + T7` or `shift + T8` opens the effect list for that slot: `turn E4` scrolls it, and `click E4` or `M1` loads the highlighted effect.","https://teenage.engineering/guides/op-xy/fx#fx",{"id":36,"text":37,"source":26,"firmware_min":21,"verified_on":21,"confidence":27},"m1","On an FX track, `M1` shows the loaded effect's parameters.",{"id":39,"text":40,"source":26,"firmware_min":21,"verified_on":21,"confidence":27},"fx1-to-fx2","On FX I, `shift + turn E4` on the `M3` page sets the send into FX II.",{"id":42,"text":43,"source":26,"firmware_min":21,"verified_on":21,"confidence":44},"one-way","The link between the slots runs one way, FX I into FX II; the guide describes no send from FX II back into FX I, so put the effect that should come first on FX I.","derived",{"id":46,"text":47,"source":48,"firmware_min":21,"verified_on":21,"confidence":44},"fx2-sends","What FX II's own `M3` shift layer holds is not documented, and that page has not yet been looked at on a unit.","docs/research/59-screen-profiling.md#213-auxiliary-tracks",{"id":50,"text":51,"source":52,"firmware_min":21,"verified_on":21,"confidence":27},"track-sends","Instrument tracks send from their send page (`shift` held on `M3`, `E3` for FX I, `E4` for FX II).","https://teenage.engineering/guides/op-xy/instrument#filter",{"id":54,"text":55,"source":56,"firmware_min":21,"verified_on":21,"confidence":27},"mix-sends","In mix mode, `M1` sets each track's FX I send with `turn E1` and FX II send with `turn E2`.","https://teenage.engineering/guides/op-xy/mix#levels-pans-and-sends",{"id":58,"text":59,"source":26,"firmware_min":21,"verified_on":21,"confidence":44},"guide-slips","The guide's FX routing card repeats a CV sentence and its filter card names the tape track — copy slips.",{"id":61,"text":62,"source":48,"firmware_min":21,"verified_on":63,"confidence":64},"screen","The FX I page is headed with a boxed FX I and the effect's name, then four columns with labels above and values below, each a bar split by a marker at the value's height.","1.1.33","verified",{"id":66,"text":67,"source":48,"firmware_min":21,"verified_on":63,"confidence":64},"type-list","On FX I, `shift + T7` lists the effects — chorus, delay, dist, lofi, phaser and reverb.",{"id":69,"text":70,"source":71,"firmware_min":21,"verified_on":63,"confidence":64},"midi","Over MIDI, CC12–15 on channel 15 move the four columns of FX I.","docs/research/59-screen-profiling.md#3-midi-reach-on-1133-verified-on-screen",[],[],[75,76,77],"fx.overview","auxiliary.routing-filter-lfo","mix.levels-pans-sends","One reverb on FX II can serve every track, each sending as much as it needs, and chaining FX I\ninto FX II lets a delay fade into reverb. The chain only runs that way round, so reverb into delay\nmeans loading the reverb on FX I and the delay on FX II. The effects themselves are described in the\neffects area.",[80,82,83,85,86,87],{"url":26,"kind":81},"guide",{"url":34,"kind":81},{"url":48,"kind":84},"research",{"url":52,"kind":81},{"url":56,"kind":81},{"url":71,"kind":84},[],{"id":9,"title":90},"Auxiliary",{"id":92,"title":93},"auxiliary.tape","Tape track",{"id":76,"title":95},"Aux routing, filter and LFO pages",{"basics.key-notation":97,"basics.main-modes":98,"basics.modules":99,"basics.track-buttons":100,"basics.linked-tracks":101,"basics.patterns-scenes-songs":102,"basics.workflow":103,"basics.firmware-versions":104,"hardware.layout":105,"hardware.power-and-charging":106,"hardware.connectors":107,"hardware.specifications":108,"hardware.te-boot":109,"hardware.firmware-update":110,"hardware.factory-reset":111,"hardware.system-menu":112,"hardware.safety-and-care":113,"hardware.in-the-box":114,"sequencer.overview":115,"sequencer.step-entry":116,"sequencer.step-recording":117,"sequencer.live-recording":118,"sequencer.extend-notes":119,"sequencer.nudge":120,"sequencer.single-sound":121,"sequencer.rotate":122,"sequencer.copy-step":123,"sequencer.transpose-sequence":124,"sequencer.parameter-locks":125,"sequencer.clear-and-undo":126,"sequencer.step-components":127,"sequencer.step-component-reference":128,"sequencer.component-pulse":129,"sequencer.component-pulse-hold":130,"sequencer.component-multiply":131,"sequencer.component-velocity":132,"sequencer.component-ramp-up":133,"sequencer.component-ramp-down":134,"sequencer.component-random":135,"sequencer.component-portamento":136,"sequencer.component-bend":137,"sequencer.component-tonality":138,"sequencer.component-jump":139,"sequencer.component-skip-parameter-lock":140,"sequencer.component-skip-step-component":141,"sequencer.component