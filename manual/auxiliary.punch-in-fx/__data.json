{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,30,64,161,176,276,307,338,363,388,410,438,448,491],{"id":3,"title":4,"units":5},"basics","Basics",[6,9,12,15,18,21,24,27],{"id":7,"title":8},"basics.key-notation","How key presses are written",{"id":10,"title":11},"basics.main-modes","Main modes",{"id":13,"title":14},"basics.modules","Module pages (M1–M4)",{"id":16,"title":17},"basics.track-buttons","Track keys and the active track",{"id":19,"title":20},"basics.linked-tracks","Linking tracks",{"id":22,"title":23},"basics.patterns-scenes-songs","Patterns, scenes, songs and projects",{"id":25,"title":26},"basics.workflow","From first notes to a song",{"id":28,"title":29},"basics.firmware-versions","Firmware versions and this manual",{"id":31,"title":32,"units":33},"hardware","Hardware",[34,37,40,43,46,49,52,55,58,61],{"id":35,"title":36},"hardware.layout","Panel layout",{"id":38,"title":39},"hardware.power-and-charging","Power, battery and charging",{"id":41,"title":42},"hardware.connectors","Connectors and jacks",{"id":44,"title":45},"hardware.specifications","Technical specifications",{"id":47,"title":48},"hardware.te-boot","TE boot (bootloader menu)",{"id":50,"title":51},"hardware.firmware-update","Updating the OS",{"id":53,"title":54},"hardware.factory-reset","Factory reset",{"id":56,"title":57},"hardware.system-menu","Function test and pot calibration (system menu)",{"id":59,"title":60},"hardware.safety-and-care","Safety, care and warranty",{"id":62,"title":63},"hardware.in-the-box","Box contents and the factory-sound licence",{"id":65,"title":66,"units":67},"sequencer","Sequencer",[68,71,74,77,80,83,86,89,92,95,98,101,104,107,110,113,116,119,122,125,128,131,134,137,140,143,146,149,152,155,158],{"id":69,"title":70},"sequencer.overview","Step sequencer overview",{"id":72,"title":73},"sequencer.step-entry","Entering notes on steps",{"id":75,"title":76},"sequencer.step-recording","Step recording",{"id":78,"title":79},"sequencer.live-recording","Live recording",{"id":81,"title":82},"sequencer.extend-notes","Extended notes and note length",{"id":84,"title":85},"sequencer.nudge","Nudging steps off the grid",{"id":87,"title":88},"sequencer.single-sound","Sequencing one sound at a time",{"id":90,"title":91},"sequencer.rotate","Shifting a sequence (rotate)",{"id":93,"title":94},"sequencer.copy-step","Copying and pasting steps",{"id":96,"title":97},"sequencer.transpose-sequence","Transposing a track's sequence",{"id":99,"title":100},"sequencer.parameter-locks","Parameter locks",{"id":102,"title":103},"sequencer.clear-and-undo","Clearing a sequence and undo",{"id":105,"title":106},"sequencer.step-components","Step components",{"id":108,"title":109},"sequencer.step-component-reference","Step component values",{"id":111,"title":112},"sequencer.component-pulse","Pulse (step component)",{"id":114,"title":115},"sequencer.component-pulse-hold","Pulse hold (step component)",{"id":117,"title":118},"sequencer.component-multiply","Multiply (step component)",{"id":120,"title":121},"sequencer.component-velocity","Velocity (step component)",{"id":123,"title":124},"sequencer.component-ramp-up","Ramp up (step component)",{"id":126,"title":127},"sequencer.component-ramp-down","Ramp down (step component)",{"id":129,"title":130},"sequencer.component-random","Random (step component)",{"id":132,"title":133},"sequencer.component-portamento","Portamento (step component)",{"id":135,"title":136},"sequencer.component-bend","Bend (step component)",{"id":138,"title":139},"sequencer.component-tonality","Tonality (step component)",{"id":141,"title":142},"sequencer.component-jump","Jump (step component)",{"id":144,"title":145},"sequencer.component-skip-parameter-lock","Skip parameter lock (step component)",{"id":147,"title":148},"sequencer.component-skip-step-component","Skip step component (step component)",{"id":150,"title":151},"sequencer.component-skip-trigger","Skip trigger (step component)",{"id":153,"title":154},"sequencer.bar-menu","Bar menu"