,552,555,558,561,564,567],{"id":496,"title":497},"howto.get-started","Get started — a first project",{"id":499,"title":500},"howto.first-drum-beat","Program a first drum beat",{"id":502,"title":503},"howto.first-bassline","Record a bassline live",{"id":505,"title":506},"howto.first-chords","Add chords on steps",{"id":508,"title":509},"howto.first-punch-in","Perform with punch-in FX",{"id":511,"title":512},"howto.enable-velocity","Make the keyboard velocity-sensitive",{"id":514,"title":515},"howto.control-synth-midi","Play an external synth over MIDI",{"id":517,"title":518},"howto.control-cv-synth","Play an analog synth with CV and gate",{"id":520,"title":521},"howto.sync-drum-machine","Sync a vintage drum machine",{"id":523,"title":524},"howto.sync-pocket-operator","Sync a pocket operator",{"id":526,"title":527},"howto.external-effect","Loop an external effect pedal",{"id":529,"title":530},"howto.midi-keyboard","Play the OP-XY from a MIDI keyboard",{"id":532,"title":533},"howto.audio-interface","Use an audio interface with the OP-XY",{"id":535,"title":536},"howto.pitchbend-modulation","Use the pitchbend strip as a modulator",{"id":538,"title":539},"howto.back-up-projects","Back up projects to a computer",{"id":541,"title":542},"howto.load-samples","Load samples from a computer",{"id":544,"title":545},"howto.song-with-brain","Sketch a song fast with the brain",{"id":547,"title":548},"howto.song-from-scenes","Build a song from scenes",{"id":550,"title":551},"howto.loop-one-scene","Loop one scene",{"id":553,"title":554},"howto.sidechain-duck","Make a track pump with the kick (duck)",{"id":556,"title":557},"howto.pluck","Turn a sound into a pluck",{"id":559,"title":560},"howto.pad-swell","A pad that swells in and fades slowly",{"id":562,"title":563},"howto.wobble","A filter wobble in time with the beat",{"id":565,"title":566},"howto.acid-bass","A squelchy acid bass",{"id":568,"title":569},"howto.slice-a-loop","Sample a loop and play it in slices"],"uses":{}},{"type":"data","data":[{"unit":1,"title":3,"area":184,"prev":186,"next":189,"titles":192,"firmware":59},{"id":2,"title":3,"aliases":4,"area":8,"order":9,"path":10,"context":11,"summary":15,"status":16,"firmware":17,"facts":24,"procedures":126,"parameters":138,"related":139,"body":142,"sources":143,"official_url":28,"controls":156},"auxiliary.punch-in-fx","Punch-in FX",[5,6,7],"punch-in","punch in effects","performance effects","auxiliary",20,"knowledge/manual/units/auxiliary/punch-in-fx.md",{"modes":12,"screens":14},[8,13],"instrument",[],"The punch-in FX track (`T2`) turns the keyboard into 24 momentary effects — lower octave for percussion tracks, upper for melodic ones; `shift + key` fires them from any instrument track.","current",{"min":18,"changed_in":19,"guide_version":22,"verified_on":23},"1.0.9",[20,21],"1.0.32","1.0.50","1.1.15",null,[25,30,34,37,40,43,47,51,55,61,64,67,70,73,78,82,85,88,91,94,97,101,104,107,110,113,116,119,123],{"id":26,"text":27,"source":28,"firmware_min":23,"verified_on":23,"confidence":29},"keys","On `T2` each of the 24 keys is a different effect that lasts while held; held keys combine.","https://teenage.engineering/guides/op-xy/get-started#4.4.%20adding-punch-in-fx","official",{"id":31,"text":32,"source":33,"firmware_min":23,"verified_on":23,"confidence":29},"octaves","The lower octave acts on the percussion tracks, the upper octave on the melodic tracks.","https://teenage.engineering/guides/op-xy/auxiliary#punch-in-fx",{"id":35,"text":36,"source":33,"firmware_min":23,"verified_on":23,"confidence":29},"motion","Some effects also respond to moving the unit (gyroscope) or to the pitchbend strip.",{"id":38,"text":39,"source":33,"firmware_min":23,"verified_on":23,"confidence":29},"shortcut","On an instrument track, `shift + key` plays punch-in FX; the lower octave affects only that track, the upper octave its whole group.",{"id":41,"text":42,"source":33,"firmware_min":23,"verified_on":23,"confidence":29},"record","Shortcut effects played while recording are written to the punch-in FX track.",{"id":44,"text":45,"source":46,"firmware_min":23,"verified_on":23,"confidence":29},"groups","Percussive engines such as the drum sampler form the percussion group; synth engines and the synth sampler the melodic group.","https://teenage.engineering/guides/op-xy/mix#master",{"id":48,"text":49,"source":50,"firmware_min":21,"verified_on":23,"confidence":29},"mute-wins","When effects conflict, the mute effect takes priority.","https://teenage.engineering/downloads/op-xy#1.0.50",{"id":52,"text":53,"source":54,"firmware_min":20,"verified_on":23,"confidence":29},"midi-shortcut","OS 1.0.32 stopped `shift + key` from triggering punch-in FX while external MIDI is in use.","https://teenage.engineering/downloads/op-xy#1.0.32",{"id":56,"text":57,"source":58,"firmware_min":23,"verified_on":59,"confidence":60},"midi-notes","Over MIDI, notes 53–76 on channel 10 fire the 24 effects as if the keys were held, with the track showing each animation.","docs/research/60-sound-session.md#6-punch-in-fx","1.1.33","verified",{"id":62,"text":63,"source":58,"firmware_min":23,"verified_on":59,"confidence":60},"effect-order","Both octaves hold the same twelve effects in the same order, F to E — mute, stutter, repeat two steps, pan, repeat three steps, octave, follow, fill or ramp up, short, hat fill or ramp down, soft attack, random. Each takes a shape suited to the group it acts on. TE has not named them; these names are descriptive.",{"id":65,"text":66,"source":58,"firmware_min":23,"verified_on":59,"confidence":60},"mute-key","F (either octave) silences its group for as long as it is held.",{"id":68,"text":69,"source":58,"firmware_min":23,"verified_on":59,"confidence":60},"stutter-key","F♯ stutters in time with the project's sixteenths — melodic tracks jump back to the start of each sixteenth several times and drop out for its last part; drums let only the first few tens of milliseconds of each sixteenth through, in mono.",{"id":71,"text":72,"source":58,"firmware_min":23,"verified_on":59,"confidence":60},"repeat-keys","A replays three sixteenths over and over, and G (on melodic tracks) two; the pattern keeps running underneath and carries on in place on release.",{"id":74,"text":75,"source":76,"firmware_min":23,"verified_on":23,"confidence":77},"repeat-swallows","While a repeat key is held, the loop replays only what the steps it caught held, so a note the pattern would start in that time, a long bass note or a pad chord, does not sound at all (the previous note rings out and releases as usual). Keys pressed later, such as the octave, still act on the notes that loop. A frame-by-frame reading of an ambient tutorial (OS 1.0.x) shows a bass and a pad silent for 21 s under G held with A♯, D, E and F♯ pressed over it (a launch stream's G held over a bass agrees on the one-step loop).","docs/research/75-ambient-frame-by-frame.md#log","community",{"id":79,"text":80,"source":58,"firmware_min":23,"verified_on":23,"confidence":81},"repeat-drums","G on the drums presumably loops two sixteenths as it does on melodic tracks; the recordings did not show it.","derived",{"id":83,"text":84,"source":58,"firmware_min":23,"verified_on":59,"confidence":60},"pan-key","G♯ moves the sound across the stereo field — each drum hit lands left or right by its place in the bar, and melodic tracks swing to one side.",{"id":86,"text":87,"source":58,"firmware_min":23,"verified_on":59,"confidence":60},"octave-key","A♯ drops melodic tracks' sequenced notes an octave.",{"id":89,"text":90,"source":58,"firmware_min":23,"verified_on":23,"confidence":81},"octave-drums","On the drums, A♯ presumably raises the sequenced hits an octave.",{"id":92,"text":93,"source":58,"firmware_min":23,"verified_on":23,"confidence":81},"follow-key","B makes the other tracks of the group play the sequenced notes too, each with its own sound (measured on a real unit by the original project). Footage of a launch stream suggests a repeat in threes instead; on the breakbeat tutorial the replica matches the recording better this way.",{"id":95,"text":96,"source":58,"firmware_min":23,"verified_on":59,"confidence":60},"fill-keys","On the drums, C adds a kick and snare fill and D a hi-hat groove (closed on every sixteenth, open on the off-beat eighths), both on top of the pattern. On OS 1.0 the C fill also rides a closed hat on every sixteenth.",{"id":98,"text":99,"source":100,"firmware_min":23,"verified_on":23,"confidence":77},"hat-fill-os10","On OS 1.0.40 the hat fill is different; open hat on every odd sixteenth, closed on every even one, where OS 1.1 plays closed hats on every sixteenth and opens the off-beat eighths (one video). The first OS 1.0 builds (a launch-day stream) open every fourth sixteenth, as OS 1.1 does.","docs/research/78-overnight-accuracy.md#log",{"id":102,"text":103,"source":58,"firmware_min":23,"verified_on":23,"confidence":81},"ramp-up","On melodic tracks, C makes notes climb higher in stages that follow the clock - about one major-scale step every three and a half sixteenths from the key going down, then round again after an octave - gliding between them. One hold of four notes (OS 1.0.40); the unit's own ramps follow the Brain's key.",{"id":105,"text":106,"source":58,"firmware_min":23,"verified_on":23,"confidence":81},"ramp-down","On melodic tracks, D makes each step's notes fall lower, gliding between them.",{"id":108,"text":109,"source":58,"firmware_min":23,"verified_on":59,"confidence":60},"short-key","C♯ cuts every note or hit to a blip of about 25 ms; on a drum key the hit also starts a few milliseconds into its sample, which takes the click off it.",{"id":111,"text":112,"source":58,"firmware_min":23,"verified_on":59,"confidence":60},"soft-key","D♯ softens attacks — drum hits fade in and synth notes swell in.",{"id":114,"text":115,"source":58,"firmware_min":23,"verified_on":23,"confidence":81},"random-key","E randomises — drum steps play random keys of the kit and melodic notes leap by random intervals.",{"id":117,"text":118,"source":58,"firmware_min":23,"verified_on":59,"confidence":60},"levels","On the drums, the repeats, octave, follow and random rework the sequencer's own pattern and leave hits arriving over MIDI untouched, while mute, stutter, pan, short and soft change every hit and the fills add hits of their own.",{"id":120,"text":121,"source":122,"firmware_min":23,"verified_on":59,"confidence":60},"animations","On `T2` each of the 24 keys plays its own animation on the screen — planets, a digit clock, noise, hands, waves, sweeping lines and bars, and more.","docs/research/59-screen-profiling.md#213-auxiliary-tracks",{"id":124,"text":125,"source":122,"firmware_min":23,"verified_on":59,"confidence":60},"idle-heartbeat","With no effect held, the page shows a single dot tracing a heartbeat line across the dot grid, about every three seconds; it starts again from the left edge each time an effect ends.",[127],{"id":128,"goal":129,"preconditions":130,"steps":132,"result":23,"source":33,"firmware_min":23,"verified_on":23,"confidence":29},"record-shortcut","Record punch-in FX from an instrument track",[131],"instrument mode",[133,136],{"keys":134,"note":135,"set":23},"record + play","start a live recording",{"keys":137,"note":23,"set":23},"shift + keys",[],[140,141],"auxiliary.overview","howto.first-punch-in","Punch-in FX are for performing: hold a key for a moment of change, let go and the track snaps back.\nRecorded passes live on their own track, so they can be edited without touching the parts below.\n\nFrom F to E, each octave runs: mute, stutter, repeat two steps, pan, repeat three steps, octave,\nfollow, a fill (drums) or rising ramp (melodic), short, a hi-hat groove (drums) or falling ramp\n(melodic), soft attack and random. The rhythmic ones follow the project tempo.",[144,146,147,148,150,151,153,154,155],{"url":28,"kind":145},"guide",{"url":33,"kind":145},{"url":46,"kind":145},{"url":50,"kind":149},"changelog",{"url":54,"kind":149},{"url":58,"kind":152},"re