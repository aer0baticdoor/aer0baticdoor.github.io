":44,"preconditions":45,"steps":46,"result":22,"source":27,"firmware_min":22,"verified_on":22,"confidence":28},"kick","Put a kick on every beat",[],[47,49,52],{"keys":48,"note":22,"set":22},"instrument → T1",{"keys":50,"note":51,"set":22},"key F3 → step 1 → step 5 → step 9 → step 13","select the kick, then place it on the four beats",{"keys":53,"note":54,"set":22},"play → stop","listen, then stop",{"id":56,"goal":57,"preconditions":58,"steps":59,"result":22,"source":27,"firmware_min":22,"verified_on":22,"confidence":28},"snare","Add a backbeat snare",[],[60],{"keys":61,"note":62,"set":22},"key G3 + record → + step 5 → + step 13","keep the snare key held throughout; only its steps are shown",{"id":64,"goal":65,"preconditions":66,"steps":67,"result":22,"source":27,"firmware_min":22,"verified_on":22,"confidence":28},"hats","Fill in hi-hats",[],[68],{"keys":69,"note":70,"set":22},"key C#4 + record → + steps","keep the key held and press every other step; TE only says “the C# key”",{"id":39,"goal":72,"preconditions":73,"steps":74,"result":80,"source":27,"firmware_min":22,"verified_on":22,"confidence":28},"Turn one hi-hat into a triple hit",[],[75,78],{"keys":76,"note":77,"set":22},"shift + step 7 → + natural 3 → + accidental 3","keep shift down; step 7 blinks, then multiply and its value are chosen",{"keys":79,"note":22,"set":22},"play","The seventh step plays three short hi-hat hits.",[],[83,84,85],"sequencer.single-sound","sequencer.step-components","howto.first-bassline","Choose a sound on the keyboard, then press the steps where it should play. The single-sound view\nkeeps kick, snare and hats out of each other's way, and one step component adds variation.",[88],{"url":27,"kind":89},"guide",[91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117],"key.instrument","track.1","keyboard.f3","step.1","step.5","step.9","step.13","key.play","key.stop","keyboard.g3","key.record","keyboard.cs4","step.2","step.3","step.4","step.6","s