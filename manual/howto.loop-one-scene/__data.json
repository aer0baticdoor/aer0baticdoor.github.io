min":31,"verified_on":25,"confidence":32},"arrange-only","`shift` and the black keys choose scenes only in arrange mode.",{"id":43,"text":44,"source":45,"firmware_min":31,"verified_on":31,"confidence":46},"clear-song","`shift + M1` in song mode empties the song order without deleting any scene, taking every scene out of the song's playback.","https://teenage.engineering/guides/op-xy/arrange#song-mode","official",{"id":48,"text":49,"source":45,"firmware_min":31,"verified_on":31,"confidence":50},"empty-song-plays-scene","With the song order empty, play has no song to run, so the scene on screen keeps playing.","derived",[52,66,77],{"id":53,"goal":54,"preconditions":55,"steps":57,"result":65,"source":30,"firmware_min":31,"verified_on":25,"confidence":32},"while-playing","Keep one scene playing, from the song",[56],"a song with several scenes",[58,61,62],{"keys":59,"note":60,"set":31},"play","the song starts from its first scene",{"keys":17,"note":31,"set":31},{"keys":63,"note":64,"set":31},"shift + accidental","the black key of the scene to keep; it takes over at once and repeats","The chosen scene plays over and over until stop.",{"id":67,"goal":68,"preconditions":69,"steps":72,"result":65,"source":30,"firmware_min":31,"verified_on":25,"confidence":32},"before-play","Start on one scene and keep it",[70,71],"arrange mode","stopped",[73,75],{"keys":63,"note":74,"set":31},"the black key of the scene to keep",{"keys":59,"note":76,"set":31},"that scene plays, not the song's first one, and repeats",{"id":78,"goal":79,"preconditions":80,"steps":81,"result":94,"source":45,"firmware_min":31,"verified_on":31,"confidence":50},"for-good","Make play keep to the current scene",[70],[82,84,87,90,92],{"keys":63,"note":83,"set":31},"choose the scene to loop",{"keys":85,"note":86,"set":31},"shift + arrange","song mode",{"keys":88,"note":89,"set":31},"shift + M1","clear the song order; the scenes themselves stay",{"keys":17,"note":91,"set":31},"back to the patterns",{"keys":59,"note":93