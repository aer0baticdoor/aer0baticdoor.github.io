,552,555,558,561,564,567],{"id":496,"title":497},"howto.get-started","Get started — a first project",{"id":499,"title":500},"howto.first-drum-beat","Program a first drum beat",{"id":502,"title":503},"howto.first-bassline","Record a bassline live",{"id":505,"title":506},"howto.first-chords","Add chords on steps",{"id":508,"title":509},"howto.first-punch-in","Perform with punch-in FX",{"id":511,"title":512},"howto.enable-velocity","Make the keyboard velocity-sensitive",{"id":514,"title":515},"howto.control-synth-midi","Play an external synth over MIDI",{"id":517,"title":518},"howto.control-cv-synth","Play an analog synth with CV and gate",{"id":520,"title":521},"howto.sync-drum-machine","Sync a vintage drum machine",{"id":523,"title":524},"howto.sync-pocket-operator","Sync a pocket operator",{"id":526,"title":527},"howto.external-effect","Loop an external effect pedal",{"id":529,"title":530},"howto.midi-keyboard","Play the OP-XY from a MIDI keyboard",{"id":532,"title":533},"howto.audio-interface","Use an audio interface with the OP-XY",{"id":535,"title":536},"howto.pitchbend-modulation","Use the pitchbend strip as a modulator",{"id":538,"title":539},"howto.back-up-projects","Back up projects to a computer",{"id":541,"title":542},"howto.load-samples","Load samples from a computer",{"id":544,"title":545},"howto.song-with-brain","Sketch a song fast with the brain",{"id":547,"title":548},"howto.song-from-scenes","Build a song from scenes",{"id":550,"title":551},"howto.loop-one-scene","Loop one scene",{"id":553,"title":554},"howto.sidechain-duck","Make a track pump with the kick (duck)",{"id":556,"title":557},"howto.pluck","Turn a sound into a pluck",{"id":559,"title":560},"howto.pad-swell","A pad that swells in and fades slowly",{"id":562,"title":563},"howto.wobble","A filter wobble in time with the beat",{"id":565,"title":566},"howto.acid-bass","A squelchy acid bass",{"id":568,"title":569},"howto.slice-a-loop","Sample a loop and play it in slices"],"uses":{}},{"type":"data","data":[{"unit":1,"title":146,"area":147,"prev":149,"next":152,"titles":155,"firmware":56},{"id":2,"title":3,"aliases":4,"area":12,"order":13,"path":14,"context":15,"summary":21,"status":22,"firmware":23,"facts":28,"procedures":61,"parameters":124,"related":125,"body":130,"sources":131,"official_url":32,"controls":138},"howto.pad-swell","Recipe — a pad that swells in and fades slowly",[5,6,7,8,9,10,11],"pad","swell","slow attack","ambient pad","fade in","long release","string swell","howto",42,"knowledge/manual/units/howto/pad-swell.md",{"modes":16,"screens":18},[17],"instrument",[19,20],"M2","M3","For a pad, play in poly with a slow attack, a high sustain and a long release — on the OP-XY that is `E4` turned counter-clockwise — open the filter slowly with its envelope and send the track to the reverb on FX II.","current",{"min":24,"changed_in":25,"guide_version":26,"verified_on":27},"1.0.9",[],"1.1.15",null,[29,34,37,40,44,48,53,58],{"id":30,"text":31,"source":32,"firmware_min":27,"verified_on":27,"confidence":33},"poly","Chords need play mode poly, `shift + turn E1` on `M2`, so that every note of the chord sounds.","https://teenage.engineering/guides/op-xy/instrument#envelopes","derived",{"id":35,"text":36,"source":32,"firmware_min":27,"verified_on":27,"confidence":33},"attack","A slow attack on `E1` of `M2` makes each chord fade in rather than start at once; the higher the value, the slower the swell.",{"id":38,"text":39,"source":32,"firmware_min":27,"verified_on":27,"confidence":33},"sustain","A high sustain keeps the chord at full level for as long as the keys are held.",{"id":41,"text":42,"source":43,"firmware_min":27,"verified_on":27,"confidence":33},"release","For a long fade after the keys come up, turn release on `E4` counter-clockwise; on the OP-XY lower release values ring longer.","docs/research/59-screen-profiling.md#22-envelope-editor-instrument-m2",{"id":45,"text":46,"source":47,"firmware_min":27,"verified_on":27,"confidence":33},"filter-swell","A slow filter attack with a positive envelope amount on `M3` opens the tone as the chord swells, so the pad brightens as it grows louder.","https://teenage.engineering/guides/op-xy/instrument#filter",{"id":49,"text":50,"source":51,"firmware_min":27,"verified_on":27,"confidence":52},"reverb","In a new project FX II holds a reverb, so the FX II send, `shift + turn E4` on `M3`, adds space to the pad.","docs/research/30-presets-samples.md#11-a-new-projects-sounds","measured",{"id":54,"text":55,"source":51,"firmware_min":27,"verified_on":56,"confidence":57},"factory","A new project's strings and pad show the shape in numbers. Draemy on `T7` (axis) swells in at attack 50 and bandpasser on `T8` (multisampler) at 35; both hold a high sustain, 76 and 99, and release at 30 and 33. Draemy's filter envelope opens at attack 64 with an envelope amount of only 17, and the track sends 53 to FX II.","1.1.33","verified",{"id":59,"text":60,"source":51,"firmware_min":27,"verified_on":27,"confidence":33},"from-a-lead","Any sound can become a pad; in a new project `T5`, the legato lead, shows every step at work, since the strings on `T7` already swell.",[62,93],{"id":6,"goal":63,"preconditions":64,"steps":66,"result":27,"source":32,"firmware_min":27,"verified_on":27,"confidence":33},"Make the chords on `T5` swell in and fade out",[65],"instrument mode",[67,70,75,81,87],{"keys":68,"note":69,"set":27},"T5 → M2","the amp envelope; click an encoder if the filter envelope is in front",{"keys":71,"note":72,"set":73},"shift + turn E1","play mode poly",{"param":74,"value":30},"play mode",{"keys":76,"note":77,"set":78},"turn E1","attack around 50, the factory strings' swell",{"param":79,"value":80},"amp attack",50,{"keys":82,"note":83,"set":84},"turn E3","sustain around 85, held high as the factory pads hold it",{"param":85,"value":86},"amp sustain",85,{"keys":88,"note":89,"set":90},"turn E4","release around 30, the factory pads' long fade",{"param":91,"value":92},"amp release",30,{"id":94,"goal":95,"preconditions":96,"steps":97,"result":27,"source":47,"firmware_min":27,"verified_on":27,"confidence":33},"brighten","Let the pad brighten as it swells, in a little reverb",[],[98,101,106,108,113,118],{"keys":99,"note":100,"set":27},"click E1","the filter envelope",{"keys":76,"note":102,"set":103},"filter attack 64, as the factory strings",{"param":104,"value":105},"filter attack",64,{"keys":20,"note":107,"set":27},"press it again if the page shows off",{"keys":76,"note":109,"set":110},"cutoff around 35",{"param":111,"value":112},"cutoff",35,{"keys":82,"note":114,"set":115},"envelope amount 17, the strings' gentle opening",{"param":116,"value":117},"env amount",17,{"keys":119,"note":120,"set":121},"shift + turn E4","FX II send 53, as the strings send",{"param":122,"value":123},"fx ii send",53,[],[126,127,128,129],"instrument.envelopes","instrument.play-mode","instrument.track-sends","howto.first-chords","A pad is a bed rather than a part: it should arrive softly, hold still and leave slowly, so\nnothing about it grabs attention from the beat. The slow amp attack and long release do most of the\nwork; the slow filter opening adds movement inside each chord. Hold chords for a bar or more and let\nthem overlap, and duck the pad with the kick if it muddies the low end.",[132,134,136,137],{"url":32,"kind":133},"guide",{"url":43,"kind":135},"research",{"url":47,"kind":133},{"url":51,"kind":135},[139,140,141,142,143,144,145],"track.5","key.m2","key.shift","encoder.1","encoder.3","encoder.4","key.m3","A pad that swells in and fades slowly",{"id":12,"title":148},"How-to recipes",{"id":150,"title":151},"howto.pluck","Turn a sound into a pluck",{"id":153,"title":154},"howto.wobble","A filter wobble in time with the beat",{"basics.key-notation":156,"basics.main-modes":157,"basics.modules":158,"basics.track-buttons":159,"basics.linked-tracks":160,"basics.patterns-scenes-songs":161,"basics.workflow":162,"basics.firmware-versions":163,"hardware.layout":164,"hardware.power-and-