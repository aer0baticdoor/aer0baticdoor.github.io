,552,555,558,561,564,567],{"id":496,"title":497},"howto.get-started","Get started — a first project",{"id":499,"title":500},"howto.first-drum-beat","Program a first drum beat",{"id":502,"title":503},"howto.first-bassline","Record a bassline live",{"id":505,"title":506},"howto.first-chords","Add chords on steps",{"id":508,"title":509},"howto.first-punch-in","Perform with punch-in FX",{"id":511,"title":512},"howto.enable-velocity","Make the keyboard velocity-sensitive",{"id":514,"title":515},"howto.control-synth-midi","Play an external synth over MIDI",{"id":517,"title":518},"howto.control-cv-synth","Play an analog synth with CV and gate",{"id":520,"title":521},"howto.sync-drum-machine","Sync a vintage drum machine",{"id":523,"title":524},"howto.sync-pocket-operator","Sync a pocket operator",{"id":526,"title":527},"howto.external-effect","Loop an external effect pedal",{"id":529,"title":530},"howto.midi-keyboard","Play the OP-XY from a MIDI keyboard",{"id":532,"title":533},"howto.audio-interface","Use an audio interface with the OP-XY",{"id":535,"title":536},"howto.pitchbend-modulation","Use the pitchbend strip as a modulator",{"id":538,"title":539},"howto.back-up-projects","Back up projects to a computer",{"id":541,"title":542},"howto.load-samples","Load samples from a computer",{"id":544,"title":545},"howto.song-with-brain","Sketch a song fast with the brain",{"id":547,"title":548},"howto.song-from-scenes","Build a song from scenes",{"id":550,"title":551},"howto.loop-one-scene","Loop one scene",{"id":553,"title":554},"howto.sidechain-duck","Make a track pump with the kick (duck)",{"id":556,"title":557},"howto.pluck","Turn a sound into a pluck",{"id":559,"title":560},"howto.pad-swell","A pad that swells in and fades slowly",{"id":562,"title":563},"howto.wobble","A filter wobble in time with the beat",{"id":565,"title":566},"howto.acid-bass","A squelchy acid bass",{"id":568,"title":569},"howto.slice-a-loop","Sample a loop and play it in slices"],"uses":{}},{"type":"data","data":[{"unit":1,"title":119,"area":120,"prev":122,"next":125,"titles":128,"firmware":297},{"id":2,"title":3,"aliases":4,"area":11,"order":12,"path":13,"context":14,"summary":19,"status":20,"firmware":21,"facts":26,"procedures":53,"parameters":98,"related":99,"body":104,"sources":105,"official_url":30,"controls":111},"howto.sidechain-duck","Recipe — make a track pump with the kick (duck)",[5,6,7,8,9,10],"sidechain","sidechain pump","pumping bass","duck the bass","pump with the kick","ducking pad","howto",40,"knowledge/manual/units/howto/sidechain-duck.md",{"modes":15,"screens":17},[16],"instrument",[18],"M4","On the track that should make room, such as a bass or a pad, pick the duck LFO on `M4`, set its source to the drum track and choose how deep and how long each dip is; the metronome as source pumps evenly with no drums at all.","current",{"min":22,"changed_in":23,"guide_version":24,"verified_on":25},"1.1.0",[],"1.1.15",null,[27,32,37,41,44,47,50],{"id":28,"text":29,"source":30,"firmware_min":25,"verified_on":25,"confidence":31},"idea","Duck lowers the level of the track it sits on whenever its source plays, so a bass or pad ducked by the drums dips on every hit and swells back between them.","https://teenage.engineering/guides/op-xy/instrument#duck","official",{"id":33,"text":34,"source":35,"firmware_min":25,"verified_on":25,"confidence":36},"pick","Choosing duck works like choosing an engine — `shift + M4` opens the list of LFO types, `turn E1` highlights duck and `click E1` takes it.","https://teenage.engineering/guides/op-xy/synth-engines#change-engine","derived",{"id":38,"text":39,"source":40,"firmware_min":25,"verified_on":25,"confidence":36},"drums","In a new project the drum kit sits on track 1, so source 1 ducks on every hit of that track, hi-hats included; a kick alone on its own track gives the classic pump.","docs/research/30-presets-samples.md#11-a-new-projects-sounds",{"id":42,"text":43,"source":30,"firmware_min":25,"verified_on":25,"confidence":31},"metronome","Turned past the tracks, the source becomes the metronome, and the track then dips on every beat whether or not anything plays.",{"id":45,"text":46,"source":30,"firmware_min":25,"verified_on":25,"confidence":36},"shared-track","When the hi-hats share the kick's track, a kick on every beat is better served by the metronome as source, which pumps on the beats only; the drum track itself would duck on every hat too.",{"id":48,"text":49,"source":30,"firmware_min":25,"verified_on":25,"confidence":36},"depth","Amount on `E2` sets how far the level drops; around 60–80 is a clear pump, lower values a gentle breathing.",{"id":51,"text":52,"source":30,"firmware_min":25,"verified_on":25,"confidence":36},"time","Hold on `E3` keeps the level down for a moment and release on `E4` sets how it recovers; keep both short for a tight pump on a fast beat, and lengthen the release for slow swells.",[54],{"id":55,"goal":56,"preconditions":57,"steps":59,"result":97,"source":30,"firmware_min":25,"verified_on":25,"confidence":36},"set-up","Make the bass on `T3` pump with the drums on `T1`",[58],"instrument mode",[60,63,66,69,75,80,86,92],{"keys":61,"note":62,"set":25},"T3 → M4","the track that should make room",{"keys":64,"note":65,"set":25},"shift + M4","the LFO types",{"keys":67,"note":68,"set":25},"turn E1","highlight duck",{"keys":70,"note":71,"set":72},"click E1","takes it; press `M4` if the page changed",{"param":73,"value":74},"lfo type","duck",{"keys":67,"note":76,"set":77},"source 1, the drum track",{"param":78,"value":79},"duck source",1,{"keys":81,"note":82,"set":83},"turn E2","amount around 70",{"param":84,"value":85},"lfo amount",70,{"keys":87,"note":88,"set":89},"turn E3","a short hold",{"param":90,"value":91},"duck hold",10,{"keys":93,"note":94,"set":95},"turn E4","release around 40",{"param":96,"value":12},"duck release","With the drums and the bass playing, the bass dips on every drum hit.",[],[100,101,102,103],"instrument.lfo-duck","instrument.lfo","howto.first-drum-beat","howto.first-bassline","Pumping makes room: the bass or pad steps out of the kick's way, so both stay loud without\nclashing, and the loop starts to breathe with the beat. The OP-XY does it with an LFO type rather\nthan a compressor, so it costs no effect slot and works on any instrument track. Duck the parts that\nshare the kick's low end, usually the bass and long pads, and leave the drums and short plucks\nalone.",[106,108,109],{"url":30,"kind":107},"guide",{"url":35,"kind":107},{"url":40,"kind":110},"research",[112,113,114,115,116,117,118],"track.3","key.m4","key.shift","encoder.1","encoder.2","encoder.3","encoder.4","Make a track pump with the kick (duck)",{"id":11,"title":121},"How-to recipes",{"id":123,"title":124},"howto.loop-one-scene","Loop one scene",{"id":126,"title":127},"howto.pluck","Turn a sound into a pluck",{"basics.key-notation":129,"basics.main-modes":130,"basics.modules":131,"basics.track-buttons":132,"basics.linked-tracks":133,"basics.patterns-scenes-songs":134,"basics.workflow":135,"basics.firmware-versions":136,"hardware.layout":137,"hardware.power-and-charging":138,"hardware.connectors":139,"hardware.specifications":140,"hardware.te-boot":141,"hardware.firmware-update":142,"hardware.factory-reset":143,"hardware.system-menu":144,"hardware.safety-and-care":145,"hardware.in-the-box":146,"sequencer.overview":147,"sequencer.step-entry":148,"sequencer.step-recording":149,"sequencer.live-recording":150,"sequencer.extend-notes":151,"sequencer.nudge":152,"sequencer.single-sound":153,"sequencer.rotate":154,"sequencer.copy-step":155,"sequencer.transpose-sequence":156,"sequencer.parameter-locks":157,"sequencer.clear-and-undo":158,"sequencer.step-components":159,"sequencer.step-component-reference":160,"sequencer.component-pulse":161,"sequencer.component-pulse-hold":162,"sequencer.component-multiply":163,"sequencer.component-velocity":164,"sequencer.component-ramp-up":165,"sequencer.component-ramp-down":166,"sequencer.component-random":