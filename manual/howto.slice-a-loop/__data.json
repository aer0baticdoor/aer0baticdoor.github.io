,552,555,558,561,564,567],{"id":496,"title":497},"howto.get-started","Get started — a first project",{"id":499,"title":500},"howto.first-drum-beat","Program a first drum beat",{"id":502,"title":503},"howto.first-bassline","Record a bassline live",{"id":505,"title":506},"howto.first-chords","Add chords on steps",{"id":508,"title":509},"howto.first-punch-in","Perform with punch-in FX",{"id":511,"title":512},"howto.enable-velocity","Make the keyboard velocity-sensitive",{"id":514,"title":515},"howto.control-synth-midi","Play an external synth over MIDI",{"id":517,"title":518},"howto.control-cv-synth","Play an analog synth with CV and gate",{"id":520,"title":521},"howto.sync-drum-machine","Sync a vintage drum machine",{"id":523,"title":524},"howto.sync-pocket-operator","Sync a pocket operator",{"id":526,"title":527},"howto.external-effect","Loop an external effect pedal",{"id":529,"title":530},"howto.midi-keyboard","Play the OP-XY from a MIDI keyboard",{"id":532,"title":533},"howto.audio-interface","Use an audio interface with the OP-XY",{"id":535,"title":536},"howto.pitchbend-modulation","Use the pitchbend strip as a modulator",{"id":538,"title":539},"howto.back-up-projects","Back up projects to a computer",{"id":541,"title":542},"howto.load-samples","Load samples from a computer",{"id":544,"title":545},"howto.song-with-brain","Sketch a song fast with the brain",{"id":547,"title":548},"howto.song-from-scenes","Build a song from scenes",{"id":550,"title":551},"howto.loop-one-scene","Loop one scene",{"id":553,"title":554},"howto.sidechain-duck","Make a track pump with the kick (duck)",{"id":556,"title":557},"howto.pluck","Turn a sound into a pluck",{"id":559,"title":560},"howto.pad-swell","A pad that swells in and fades slowly",{"id":562,"title":563},"howto.wobble","A filter wobble in time with the beat",{"id":565,"title":566},"howto.acid-bass","A squelchy acid bass",{"id":568,"title":569},"howto.slice-a-loop","Sample a loop and play it in slices"],"uses":{}},{"type":"data","data":[{"unit":1,"title":136,"area":137,"prev":139,"next":26,"titles":142,"firmware":312},{"id":2,"title":3,"aliases":4,"area":11,"order":12,"path":13,"context":14,"summary":20,"status":21,"firmware":22,"facts":27,"procedures":64,"parameters":114,"related":115,"body":120,"sources":121,"official_url":31,"controls":128},"howto.slice-a-loop","Recipe — sample a loop and play it in slices",[5,6,7,8,9,10],"slice a loop","chop a break","sample a loop","record a loop onto a key","even slices","slice a sample into the keys","howto",45,"knowledge/manual/units/howto/slice-a-loop.md",{"modes":15,"screens":17},[16],"instrument",[18,19],"sample","M1","On a drum track, record a loop onto its top key from the `sample` page, then hold that key and press `M1` to cut it into even slices that spread over the keyboard and choke each other, ready to replay in a new order.","current",{"min":23,"changed_in":24,"guide_version":25,"verified_on":26},"1.1.0",[],"1.1.15",null,[28,33,37,41,45,48,51,54,57,61],{"id":29,"text":30,"source":31,"firmware_min":26,"verified_on":26,"confidence":32},"drum-track","Slicing is the drum sampler's, and a new project has drum kits on `T1` and `T2`.","https://teenage.engineering/guides/op-xy/sample#sample-slicer","official",{"id":34,"text":35,"source":36,"firmware_min":26,"verified_on":26,"confidence":32},"record-onto-key","On a drum track the take goes to the key you press on the record page (it lights up), so open `sample` first and choose the key there.","https://teenage.engineering/guides/op-xy/sample#drum-sampler",{"id":38,"text":39,"source":40,"firmware_min":26,"verified_on":26,"confidence":32},"inputs","On the record page `turn E1` picks the source (the built-in mic, line in or USB), `turn E3` the gain and `turn E4` the threshold.","https://teenage.engineering/guides/op-xy/sample#arrange",{"id":42,"text":43,"source":40,"firmware_min":26,"verified_on":26,"confidence":44},"threshold","Holding `M1` arms the recorder and the take begins once the input passes the threshold, so a low threshold catches the loop's first hit.","derived",{"id":46,"text":47,"source":31,"firmware_min":26,"verified_on":26,"confidence":32},"open","Holding a key and pressing `M1` opens the slicer on that key's sample.",{"id":49,"text":50,"source":31,"firmware_min":26,"verified_on":26,"confidence":44},"even","Even mode splits the sample into equal parts and `turn E4` sets how many; sixteen suits a one-bar loop cut into sixteenths.",{"id":52,"text":53,"source":31,"firmware_min":26,"verified_on":26,"confidence":32},"spread","The slices spread over the keyboard and choke each other, so one slice sounds at a time, as in a chopped break.",{"id":55,"text":56,"source":31,"firmware_min":26,"verified_on":26,"confidence":44},"top-key","The replica fills the keys from the lowest, F3, upward (the guide says only that the slices fill the keyboard), so a loop kept on the top key, E5, stays whole there for up to 23 slices.",{"id":58,"text":59,"source":60,"firmware_min":26,"verified_on":26,"confidence":44},"done","The slicer offers cancel and done, which the guide does not place on keys; the replica puts done on `M4` and cancel on `M3`.","docs/research/50-hardware-ui.md#33-page-catalogue",{"id":62,"text":63,"source":31,"firmware_min":26,"verified_on":26,"confidence":44},"transient","For a drum loop with clear hits, transient mode cuts at the loudest ones instead; a sample with fewer hits gives fewer slices than `E4` asks for.",[65,94],{"id":66,"goal":67,"preconditions":68,"steps":70,"result":93,"source":40,"firmware_min":26,"verified_on":26,"confidence":44},"record","Record a loop onto the drum track's top key",[69],"the loop plays into line in",[71,74,76,82,87,90],{"keys":72,"note":73,"set":26},"T1","the drum track",{"keys":18,"note":75,"set":26},"its record page",{"keys":77,"note":78,"set":79},"turn E1","line in",{"param":80,"value":78,"area":18,"track":81},"source",1,{"keys":83,"note":84,"set":85},"turn E4","a low threshold, around 10",{"param":42,"value":86,"area":18,"track":81},10,{"keys":88,"note":89,"set":26},"key E5","the top key lights up; the take will land here",{"keys":91,"note":92,"set":26},"hold M1","start the loop playing and hold until it has played through; the take starts at its first hit","E5 holds the loop, and a copy is kept in the user sample folder.",{"id":95,"goal":96,"preconditions":97,"steps":98,"result":113,"source":31,"firmware_min":26,"verified_on":26,"confidence":44},"slice","Cut the loop into sixteen even slices",[],[99,101,104,105,107],{"keys":72,"note":100,"set":26},"the lit track key leaves the record page for the drum page; on the record page the next combo would record again",{"keys":102,"note":103,"set":26},"key E5 + M1","hold the loop's key; the slicer opens on it",{"keys":77,"note":49,"set":26},{"keys":83,"note":106,"set":26},"sixteen slices",{"keys":108,"note":109,"set":110},"M4","done (on the replica; press the key your screen labels done)",{"param":9,"value":111,"area":18,"track":81,"key":112},16,"E5","Sixteen keys play the loop's sixteenths in order, each cutting off the one before; E5 still plays the whole loop.",[],[116,117,118,119],"sampler.slicing","sampler.sampling","sampler.drum-sampler","howto.load-samples","Slicing turns a recording into an instrument: once the loop is spread over the keys, step-enter the\nslices in a new order, repeat the kick slice, or play the hits live against the original loop on\nE5. Even slices keep the loop's timing grid, so a straight beat cut into sixteenths lines up with\nthe sequencer's steps; tap mode suits phrases that do not sit on a grid.",[122,124,125,126],{"url":31,"kind":123},"guide",{"url":36,"kind":123},{"url":40,"kind":123},{"url":60,"kind":127},"research",[129,130,131,132,133,134,135],"track.1","key.sample","encoder.1","encoder.4","keyboard.e5","key.m1","key.m4","Sample a loop and play it in slices",{"id":11,"title":138},"How-to recipes",{"id":140,"title":141},"howto.acid-bass","A squelchy acid bass",{"basics.key-notation":143,"ba