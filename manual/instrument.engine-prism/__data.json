,552,555,558,561,564,567],{"id":496,"title":497},"howto.get-started","Get started — a first project",{"id":499,"title":500},"howto.first-drum-beat","Program a first drum beat",{"id":502,"title":503},"howto.first-bassline","Record a bassline live",{"id":505,"title":506},"howto.first-chords","Add chords on steps",{"id":508,"title":509},"howto.first-punch-in","Perform with punch-in FX",{"id":511,"title":512},"howto.enable-velocity","Make the keyboard velocity-sensitive",{"id":514,"title":515},"howto.control-synth-midi","Play an external synth over MIDI",{"id":517,"title":518},"howto.control-cv-synth","Play an analog synth with CV and gate",{"id":520,"title":521},"howto.sync-drum-machine","Sync a vintage drum machine",{"id":523,"title":524},"howto.sync-pocket-operator","Sync a pocket operator",{"id":526,"title":527},"howto.external-effect","Loop an external effect pedal",{"id":529,"title":530},"howto.midi-keyboard","Play the OP-XY from a MIDI keyboard",{"id":532,"title":533},"howto.audio-interface","Use an audio interface with the OP-XY",{"id":535,"title":536},"howto.pitchbend-modulation","Use the pitchbend strip as a modulator",{"id":538,"title":539},"howto.back-up-projects","Back up projects to a computer",{"id":541,"title":542},"howto.load-samples","Load samples from a computer",{"id":544,"title":545},"howto.song-with-brain","Sketch a song fast with the brain",{"id":547,"title":548},"howto.song-from-scenes","Build a song from scenes",{"id":550,"title":551},"howto.loop-one-scene","Loop one scene",{"id":553,"title":554},"howto.sidechain-duck","Make a track pump with the kick (duck)",{"id":556,"title":557},"howto.pluck","Turn a sound into a pluck",{"id":559,"title":560},"howto.pad-swell","A pad that swells in and fades slowly",{"id":562,"title":563},"howto.wobble","A filter wobble in time with the beat",{"id":565,"title":566},"howto.acid-bass","A squelchy acid bass",{"id":568,"title":569},"howto.slice-a-loop","Sample a loop and play it in slices"],"uses":{}},{"type":"data","data":[{"unit":1,"title":3,"area":141,"prev":143,"next":146,"titles":149,"firmware":21},{"id":2,"title":3,"aliases":4,"area":8,"order":9,"path":10,"context":11,"summary":15,"status":16,"firmware":17,"facts":22,"procedures":70,"parameters":92,"related":118,"body":121,"sources":122,"official_url":26,"controls":134},"instrument.engine-prism","Prism synth engine",[5,6,7],"prism","prism engine","prism synth","instrument",50,"knowledge/manual/units/instrument/engine-prism.md",{"modes":12,"screens":13},[8],[14],"M1","A general-purpose synth engine for bass lines, leads and most other parts; its `M1` page covers waveform, oscillator ratio, detune and stereo width.","current",{"min":18,"changed_in":19,"guide_version":20,"verified_on":21},"1.0.9",[],"1.1.15","1.1.33",[23,29,33,37,41,46,50,53,57,60,63,67],{"id":24,"text":25,"source":26,"firmware_min":27,"verified_on":27,"confidence":28},"one-of-eight","Prism is one of the eight built-in synth engines. Each instrument track runs one engine, chosen per track.","https://teenage.engineering/guides/op-xy/synth-engines#arrange",null,"official",{"id":30,"text":31,"source":32,"firmware_min":27,"verified_on":27,"confidence":28},"character","Prism is the everyday workhorse among the engines, suited to bass lines, leads and most parts in between.","https://teenage.engineering/guides/op-xy/synth-engines#prism",{"id":34,"text":35,"source":36,"firmware_min":27,"verified_on":27,"confidence":28},"m1-is-engine","Only the `M1` page belongs to the engine. Envelopes (`M2`), filter (`M3`) and LFO (`M4`) work the same whichever synth engine a track uses.","https://teenage.engineering/guides/op-xy/instrument#engine",{"id":38,"text":39,"source":40,"firmware_min":27,"verified_on":27,"confidence":28},"lockable","Like every module-page parameter, prism's four `M1` settings can be parameter-locked per step.","https://teenage.engineering/guides/op-xy/sequencer#step-sequencing",{"id":42,"text":43,"source":44,"firmware_min":27,"verified_on":21,"confidence":45},"midi-ccs","Over MIDI, CC12, CC13, CC14 and CC15 on the track's channel move shape, ratio, detune and stereo.","docs/research/59-screen-profiling.md#3-midi-reach-on-1133-verified-on-screen","verified",{"id":47,"text":48,"source":49,"firmware_min":27,"verified_on":21,"confidence":45},"picture","Prism's picture is a row of four optics — a triangle, a convex lens, a concave lens and a wedge — with light rays passing through the lenses on every note.","docs/research/59-screen-profiling.md#25-engine-pages-instrument-m1",{"id":51,"text":52,"source":49,"firmware_min":27,"verified_on":21,"confidence":45},"drawn","Shape grows the triangle, ratio thickens the convex lens, detune slides the concave lens and stereo opens the wedge into an arrowhead.",{"id":54,"text":55,"source":56,"firmware_min":27,"verified_on":21,"confidence":45},"shape-range","Shape runs from a saw at 0 to a square at about 50, then narrows the two oscillators' pulses one after the other up to 99. Low is full and buzzy (every harmonic), the middle hollow (the even harmonics gone), the top thin and nasal.","docs/research/57-synth-engines.md#prism--shape-ratio-detune-stereo",{"id":58,"text":59,"source":56,"firmware_min":27,"verified_on":21,"confidence":45},"detune-cents","Detune moves the second oscillator up to about 15 cents from the first, the same amount on every note, so the two beat slowly against each other, faster toward the top.",{"id":61,"text":62,"source":56,"firmware_min":27,"verified_on":21,"confidence":45},"ratio-meaning","Ratio tunes the second oscillator against the first, an octave below at 2:1, in unison at 1:1, a fifth above at 2:3, an octave above at 1:2, and on up to four octaves above at 1:16, where it reads as a high overtone over the note more than a second note.",{"id":64,"text":65,"source":66,"firmware_min":27,"verified_on":21,"confidence":45},"stereo-copy","Stereo adds a copy of the sound through a slowly sweeping delay, a little sharp in one channel while flat in the other; up to the middle it fades the copy in, past it the sweep widens and quickens. The copy is high-passed, so the bass stays in the centre, and at 0 the sound is mono.","docs/research/57-synth-engines.md#simple--shape-pw-noise-stereo",{"id":68,"text":69,"source":56,"firmware_min":27,"verified_on":21,"confidence":45},"ratio-steps","Ratio moves in ten equal steps of its 0–99 value and reads as the oscillators' frequency ratio, a step each ten — 00–09 2:1, 10–19 1:1, 20–29 2:3, 30–39 1:2, 40–49 1:3, 50–59 1:4, 60–69 1:6, 70–79 1:8, 80–89 1:12 and 90–99 1:16.",[71],{"id":72,"goal":73,"preconditions":74,"steps":77,"result":90,"source":91,"firmware_min":27,"verified_on":27,"confidence":28},"choose","Put the prism engine on the selected instrument track",[75,76],"instrument mode","the track is selected",[78,81,84,87],{"keys":79,"note":80,"set":27},"shift + M1","the preset browser (OS 1.1.33 opens it by engine, OS 1.2 by category)",{"keys":82,"note":83,"set":27},"click E1","only if it lists categories; a click swaps to by engine",{"keys":85,"note":86,"set":27},"turn E1","scroll to prism; its first preset is highlighted",{"keys":88,"note":89,"set":27},"click E2","loads it, the whole sound with it","The track now plays through prism and `M1` shows its four parameters.","https://teenage.engineering/guides/op-xy/synth-engines#change-engine",[93,100,106,112],{"screen":14,"encoder":94,"layer":95,"keys":85,"name":96,"range":27,"default":27,"cc":97,"cc_confidence":98,"note":99,"source":32,"firmware_min":27,"verified_on":27,"confidence":28},"E1","base","shape",12,"community-verified","waveform of the oscillators",{"screen":14,"encoder":101,"layer":95,"keys":102,"name":103,"range":27,"default":27,"cc":104,"cc_confidence":98,"note":105,"source":32,"firmware_min":27,"verified_on":27,"confidence":28},"E2","turn E2","ratio",13,"tuning ratio between the oscillators",{"screen":14,"encoder":107,"layer":95,"keys":108,"name":109,"range":27,"default":27,"cc":110,"cc_confidence":98,"note":111,"source":32,"firmware_min":27,"verified_on":27,"confidence":28},"E3","turn E3","detune",14,"small pitch offset between the oscillators, for a thicker sound",{"screen":14,"encoder":113,"layer":95,"keys":114,"name":115,"range":27,"default":27,"cc":116,"cc_confidence":98,"note":117,"source":32,"firmware_min":27,"verified_on":27,"confidence":28},"E4","turn E4","stereo",15,"how far the oscillators spread across the stereo field",[119,120],"sequencer.parameter-locks","instrument.save-to-same-snapshot","Prism runs several oscillators and gives you four controls over how they relate: their waveform,\ntheir tuning ratio, how far apart they drift in pitch and how wide they spread. Little detune and a\nnarrow image keep it tight for bass; more of both makes it broad enough for leads and pads.\n\nEverything else about the sound — how notes start and fade (`M2`), the filter (`M3`) and modulation\n(`M4`) — is shared by all engines, so a prism patch is shaped the same way as any other synth patch.\nTE's guide gives no numeric ranges or defaults for prism's parameters; the screen shows them as you\nturn, and the CC numbers are confirmed on OS 1.1.33.",[123,125,126,127,128,130,131,132,133],{"url":26,"kind":124},"guide",{"url":32,"kind":124},{"url":36,"kind":124},{"url":40,"kind":124},{"url":44,"kind":129},"research",{"url":49,"kind":129},{"url":56,"kind":129},{"url":66,"kind":129},{"url":91,"kind":124},[135,136,137,138,139,140],"key.shift","key.m1","encoder.1","encoder.2","encoder.3","encoder.4",{"id":8,"title":142},"Instrument",{"id":144,"title":145},"instrument.engine-organ","Organ synth engine",{"id":147,"title":148},"instrument.engine-simple","Simple synth engine",{"basics.key-notation":150,"basics.main-modes":151,"basics.modules":152,"basics.track-buttons":153,"basics.linked-tracks":154,"basics.patterns-scenes-songs":155,"basics.workflow":156,"basics.firmware-versions":157,"hardware.layout":158,"hardware.power-and-charging":159,"hardware.connectors":160,"hardware.specifications":16