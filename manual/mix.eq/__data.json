,552,555,558,561,564,567],{"id":496,"title":497},"howto.get-started","Get started — a first project",{"id":499,"title":500},"howto.first-drum-beat","Program a first drum beat",{"id":502,"title":503},"howto.first-bassline","Record a bassline live",{"id":505,"title":506},"howto.first-chords","Add chords on steps",{"id":508,"title":509},"howto.first-punch-in","Perform with punch-in FX",{"id":511,"title":512},"howto.enable-velocity","Make the keyboard velocity-sensitive",{"id":514,"title":515},"howto.control-synth-midi","Play an external synth over MIDI",{"id":517,"title":518},"howto.control-cv-synth","Play an analog synth with CV and gate",{"id":520,"title":521},"howto.sync-drum-machine","Sync a vintage drum machine",{"id":523,"title":524},"howto.sync-pocket-operator","Sync a pocket operator",{"id":526,"title":527},"howto.external-effect","Loop an external effect pedal",{"id":529,"title":530},"howto.midi-keyboard","Play the OP-XY from a MIDI keyboard",{"id":532,"title":533},"howto.audio-interface","Use an audio interface with the OP-XY",{"id":535,"title":536},"howto.pitchbend-modulation","Use the pitchbend strip as a modulator",{"id":538,"title":539},"howto.back-up-projects","Back up projects to a computer",{"id":541,"title":542},"howto.load-samples","Load samples from a computer",{"id":544,"title":545},"howto.song-with-brain","Sketch a song fast with the brain",{"id":547,"title":548},"howto.song-from-scenes","Build a song from scenes",{"id":550,"title":551},"howto.loop-one-scene","Loop one scene",{"id":553,"title":554},"howto.sidechain-duck","Make a track pump with the kick (duck)",{"id":556,"title":557},"howto.pluck","Turn a sound into a pluck",{"id":559,"title":560},"howto.pad-swell","A pad that swells in and fades slowly",{"id":562,"title":563},"howto.wobble","A filter wobble in time with the beat",{"id":565,"title":566},"howto.acid-bass","A squelchy acid bass",{"id":568,"title":569},"howto.slice-a-loop","Sample a loop and play it in slices"],"uses":{}},{"type":"data","data":[{"unit":1,"title":3,"area":124,"prev":126,"next":129,"titles":131,"firmware":44},{"id":2,"title":3,"aliases":4,"area":11,"order":12,"path":13,"context":14,"summary":18,"status":19,"firmware":20,"facts":25,"procedures":63,"parameters":80,"related":105,"body":109,"sources":110,"official_url":29,"controls":117},"mix.eq","Master EQ",[5,6,7,8,9,10],"eq","equalizer","equaliser","master equalizer","low mid high","eq blend","mix",30,"knowledge/manual/units/mix/eq.md",{"modes":15,"screens":16},[11],[17],"M2","Mix `M2` is a three-band EQ on the master — low, mid, high — plus a blend that fades from flat to the set curve; clicking an encoder resets its band, and `E4`'s click resets the whole EQ.","current",{"min":21,"changed_in":22,"guide_version":23,"verified_on":24},"1.0.9",[23],"1.1.15",null,[26,31,34,37,40,46,49,54,57,60],{"id":27,"text":28,"source":29,"firmware_min":24,"verified_on":24,"confidence":30},"master","The EQ on mix `M2` shapes the whole mix, not individual tracks.","https://teenage.engineering/guides/op-xy/mix#eq","official",{"id":32,"text":33,"source":29,"firmware_min":24,"verified_on":24,"confidence":30},"bands","`E1`, `E2` and `E3` boost or cut the low, mid and high frequencies.",{"id":35,"text":36,"source":29,"firmware_min":24,"verified_on":24,"confidence":30},"blend","`E4` fades between a flat response and the band settings: low values leave the mix neutral, high values apply the boosts and cuts in full.",{"id":38,"text":39,"source":29,"firmware_min":23,"verified_on":24,"confidence":30},"reset","Clicking `E1`, `E2` or `E3` resets that band; clicking `E4` resets every EQ value.",{"id":41,"text":42,"source":43,"firmware_min":24,"verified_on":44,"confidence":45},"midi","Over MIDI, CC90 moves the EQ bands, the channel choosing which — 1 low, 2 mid, 3 high.","docs/research/59-screen-profiling.md#210-mixer","1.1.33","verified",{"id":47,"text":48,"source":43,"firmware_min":24,"verified_on":44,"confidence":45},"midi-blend","CC90 on channel 4 changed nothing visible on the EQ page, so no MIDI control for blend is confirmed.",{"id":50,"text":51,"source":52,"firmware_min":24,"verified_on":24,"confidence":53},"isolator","The bands behave like a DJ isolator rather than gentle shelves - turning the mid and high bands fully down leaves only the low end, the mix falling away steeply from about 300 Hz (a TE engineer demonstrating the EQ with music playing; where the mid and high bands split and how far a band boosts are estimates).","https://youtu.be/6ElRS6F5g2c","community",{"id":55,"text":56,"source":43,"firmware_min":24,"verified_on":44,"confidence":45},"screen","The EQ page pictures the three bands as groups of panels standing on an isometric grid floor, next to a slider track with an N at one end.",{"id":58,"text":59,"source":43,"firmware_min":24,"verified_on":44,"confidence":45},"bands-drawn","Each band tilts its own group of panels, flat at the minimum and rising with the value to lean at about 60° at the maximum, never fully upright; in a new project all three bands sat at the middle value, 64.",{"id":61,"text":62,"source":43,"firmware_min":24,"verified_on":44,"confidence":45},"blend-drawn","Turning `E4` slides a knob along that track and reshapes the whole scene; as it travels, the low and high panels flatten and the mid panels stand up.",[64,71],{"id":65,"goal":66,"preconditions":67,"steps":68,"result":24,"source":29,"firmware_min":24,"verified_on":24,"confidence":30},"open","Open the master EQ",[],[69],{"keys":70,"note":24,"set":24},"mix → M2",{"id":72,"goal":73,"preconditions":74,"steps":77,"result":24,"source":29,"firmware_min":23,"verified_on":24,"confidence":30},"reset-all","Flatten the EQ",[75,76],"mix mode","`M2`",[78],{"keys":79,"note":24,"set":24},"click E4",[81,87,92,97,101],{"screen":17,"encoder":82,"layer":83,"keys":84,"name":85,"range":24,"default":24,"cc":24,"cc_confidence":24,"note":86,"source":29,"firmware_min":24,"verified_on":24,"confidence":30},"E1","base","turn E1","low","boost or cut the lows",{"screen":17,"encoder":88,"layer":83,"keys":89,"name":90,"range":24,"default":24,"cc":24,"cc_confidence":24,"note":91,"source":29,"firmware_min":24,"verified_on":24,"confidence":30},"E2","turn E2","mid","boost or cut the mids",{"screen":17,"encoder":93,"layer":83,"keys":94,"name":95,"range":24,"default":24,"cc":24,"cc_confidence":24,"note":96,"source":29,"firmware_min":24,"verified_on":24,"confidence":30},"E3","turn E3","high","boost or cut the highs",{"screen":17,"encoder":98,"layer":83,"keys":99,"name":35,"range":24,"default":24,"cc":24,"cc_confidence":24,"note":100,"source":29,"firmware_min":24,"verified_on":24,"confidence":30},"E4","turn E4","flat at low values, full curve at high values",{"screen":17,"encoder":98,"layer":102,"keys":79,"name":103,"range":24,"default":24,"cc":24,"cc_confidence":24,"note":104,"source":29,"firmware_min":23,"verified_on":24,"confidence":30},"click","reset all","flattens the whole EQ",[106,107,108],"mix.overview","mix.saturator","mix.master","The blend control is the trick: set low, mid and high to an extreme curve — lows cut away for a\nbreakdown, say — keep blend at zero, and bring it up when the moment comes. At low blend values the\nEQ stays neutral whatever the bands say, which makes sweeps quick and repeatable on stage.",[111,113,115],{"url":29,"kind":112},"guide",{"url":43,"kind":114},"research",{"url":52,"kind":116},"web",[118,119,120,121,122,123],"key.mix","key.m2","encoder.4","encoder.1","encoder.2","encoder.3",{"id":11,"title":125},"Mix",{"id":127,"title":128},"mix.mute-solo","Mute and solo",{"id":107,"title":130},"Master saturator",{"basics.key-notation":132,"basics.main-modes":133,"basics.modules":134,"basics.track-buttons":135,"basics.linked-tracks":136,"basics.patterns-scenes-songs":137,"basics.workflow":138,"basics.firmware-versions":139,"hardware.layout":140,"hardware.power-and-charging":141,"hardware.connectors":142,"hardware.specifications":143,"hardware.te-boot":144,"hardware.firmware-update":145,"hardware.fact