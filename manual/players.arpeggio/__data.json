,552,555,558,561,564,567],{"id":496,"title":497},"howto.get-started","Get started — a first project",{"id":499,"title":500},"howto.first-drum-beat","Program a first drum beat",{"id":502,"title":503},"howto.first-bassline","Record a bassline live",{"id":505,"title":506},"howto.first-chords","Add chords on steps",{"id":508,"title":509},"howto.first-punch-in","Perform with punch-in FX",{"id":511,"title":512},"howto.enable-velocity","Make the keyboard velocity-sensitive",{"id":514,"title":515},"howto.control-synth-midi","Play an external synth over MIDI",{"id":517,"title":518},"howto.control-cv-synth","Play an analog synth with CV and gate",{"id":520,"title":521},"howto.sync-drum-machine","Sync a vintage drum machine",{"id":523,"title":524},"howto.sync-pocket-operator","Sync a pocket operator",{"id":526,"title":527},"howto.external-effect","Loop an external effect pedal",{"id":529,"title":530},"howto.midi-keyboard","Play the OP-XY from a MIDI keyboard",{"id":532,"title":533},"howto.audio-interface","Use an audio interface with the OP-XY",{"id":535,"title":536},"howto.pitchbend-modulation","Use the pitchbend strip as a modulator",{"id":538,"title":539},"howto.back-up-projects","Back up projects to a computer",{"id":541,"title":542},"howto.load-samples","Load samples from a computer",{"id":544,"title":545},"howto.song-with-brain","Sketch a song fast with the brain",{"id":547,"title":548},"howto.song-from-scenes","Build a song from scenes",{"id":550,"title":551},"howto.loop-one-scene","Loop one scene",{"id":553,"title":554},"howto.sidechain-duck","Make a track pump with the kick (duck)",{"id":556,"title":557},"howto.pluck","Turn a sound into a pluck",{"id":559,"title":560},"howto.pad-swell","A pad that swells in and fades slowly",{"id":562,"title":563},"howto.wobble","A filter wobble in time with the beat",{"id":565,"title":566},"howto.acid-bass","A squelchy acid bass",{"id":568,"title":569},"howto.slice-a-loop","Sample a loop and play it in slices"],"uses":{}},{"type":"data","data":[{"unit":1,"title":3,"area":181,"prev":183,"next":184,"titles":187,"firmware":64},{"id":2,"title":3,"aliases":4,"area":12,"order":13,"path":14,"context":15,"summary":21,"status":22,"firmware":23,"facts":32,"procedures":84,"parameters":96,"related":134,"body":138,"sources":139,"official_url":36,"controls":151},"players.arpeggio","Arpeggio player",[5,6,7,8,9,10,11],"arpeggio","arp","arpeggiator","arp speed","arp pattern","arp hold","latch","players",10,"knowledge/manual/units/players/arpeggio.md",{"modes":16,"screens":19},[17,18],"instrument","auxiliary",[20],"player","Plays held or sequenced notes one after another; the encoders set speed, note order, range and hold, and the shift layer adds note length, style, glide and stereo spread.","outdated-in-guide",{"min":24,"changed_in":25,"guide_version":30,"verified_on":31},"1.0.9",[26,27,28,29],"1.0.15","1.1.0","1.1.17","1.1.21","1.1.15",null,[33,38,41,45,49,53,56,60,66,69,74,77,81],{"id":34,"text":35,"source":36,"firmware_min":31,"verified_on":31,"confidence":37},"what","The arpeggio player breaks the notes a track receives into a repeating run, playing them one at a time instead of together.","https://teenage.engineering/guides/op-xy/players#arpeggio","official",{"id":39,"text":40,"source":36,"firmware_min":31,"verified_on":31,"confidence":37},"style-vs-pattern","The guide says that both pattern (`E2`) and the shift-layer style change the order of the notes, without explaining how the two differ.",{"id":42,"text":43,"source":44,"firmware_min":26,"verified_on":31,"confidence":37},"linked","Notes made by the arpeggio are not passed on to linked tracks.","https://teenage.engineering/downloads/op-xy#1.0.15",{"id":46,"text":47,"source":48,"firmware_min":27,"verified_on":31,"confidence":37},"muted","Since OS 1.1.0, held arpeggio notes still sound when their track is muted.","https://teenage.engineering/downloads/op-xy#1.1.0",{"id":50,"text":51,"source":52,"firmware_min":28,"verified_on":31,"confidence":37},"sustain","Since OS 1.1.17, a sustain pedal has no effect on arpeggiated notes.","https://teenage.engineering/downloads/op-xy#1.1.17",{"id":54,"text":55,"source":52,"firmware_min":28,"verified_on":31,"confidence":37},"brain","Since OS 1.1.17, the brain transposes arpeggios along with the rest of the track.",{"id":57,"text":58,"source":59,"firmware_min":29,"verified_on":31,"confidence":37},"pattern-switch","Since OS 1.1.21, moving to another pattern stops any arpeggio notes that were being held.","https://teenage.engineering/downloads/op-xy#1.1.21",{"id":61,"text":62,"source":63,"firmware_min":31,"verified_on":64,"confidence":65},"screen","The arpeggio page shows four boxes in the encoders' greys — a note value for speed, the pattern as a small staircase (or peak, arrow, scattered blocks), a ladder with the octave count for range, and a hand for hold, pale when off and black when on — then a small arrow meaning the page has a shift layer. Under the word arpeggio, fourteen pale blue bars picture the run, one per note, taller for higher notes; a range of 4 over a triad makes a twelve-step staircase.","docs/research/59-screen-profiling.md#27-players","1.1.33","verified",{"id":67,"text":68,"source":63,"firmware_min":31,"verified_on":64,"confidence":65},"speeds","Speed shows only a note symbol. It runs from a quarter note (slowest) to a 64th (fastest), with triplets among them; there is no number.",{"id":70,"text":71,"source":72,"firmware_min":31,"verified_on":31,"confidence":73},"quarter-triplet","A quarter-note triplet sits between the quarter and the eighth, so the slow end runs 1/4, 1/4 triplet, 1/8, 1/8 triplet (a tutorial on OS 1.0.38 or older).","docs/research/73-overnight-run.md#log","community",{"id":75,"text":76,"source":63,"firmware_min":31,"verified_on":64,"confidence":65},"shift-screen","With `shift` held the boxes change to the shift controls — two tied notes whose tie fills white as the note length grows, the style (the first reads off, the others are small bar charts), a squiggle that darkens from the left as glide rises, and a ring that splits into two as stereo rises.",{"id":78,"text":79,"source":80,"firmware_min":31,"verified_on":31,"confidence":73},"styles","The shift layer's style knob has six places, off and then five variations drawn as bar pictures, in this order — hill (climbing bars that drop on the last step), saw (climbing bars with a dip every second bar), thumb, trio and double. Hill and saw reorder the notes and the pattern then walks that order; thumb, trio and double rework the run the pattern plays (under a random pattern, double plays each random pick twice). With four held notes D, E, F and A on pattern up, thumb plays D E D F D A, double D D E E F F A A, and trio D E F D A E D F A, a nine-step cycle. Saw plays the first note, then each further note followed by the one before it (over eight notes 1 3 2 4 3 5 4 6 5 7 6 8 7; under up/down the list is walked there and back, 24 steps). Hill on pattern up over eight notes plays them in order but swaps the top two notes of the upper octave on one pass and of the lower octave on the next (one stretch of one video, the least sure of the five). The guide names none of them (OS 1.x, heard in the sound).","docs/research/78-overnight-accuracy.md#log",{"id":82,"text":83,"source":80,"firmware_min":31,"verified_on":31,"confidence":73},"tape-keys","On the tape track an arpeggio over a held chord plays tape keys, so it fires clips (one video, OS 1.x).",[85],{"id":11,"goal":86,"preconditions":87,"steps":89,"result":31,"source":36,"firmware_min":31,"verified_on":31,"confidence":37},"Keep an arpeggio running without holding the keys",[88],"the arpeggio player is on for the selected track",[90,93],{"keys":91,"note":92,"set":31},"turn E4","switch hold on",{"keys":94,"note":95,"set":31},"keys","play the notes, then let go",[97,103,108,113,118,122,126,130],{"screen":20,"encoder":98,"layer":99,"keys":100,"name":101,"range":31,"default":31,"cc":31,"cc_confidence":31,"note":102,"source":36,"firmware_min":31,"verified_on":31,"confidence":37},"E1","base","turn E1","speed","rate of the run",{"screen":20,"encoder":104,"layer":99,"keys":105,"name":106,"range":31,"default":31,"cc":31,"cc_confidence":31,"note":107,"source":36,"firmware_min":31,"verified_on":31,"confidence":37},"E2","turn E2","pattern","random, play order, up, down, up/down or up/repeat/down",{"screen":20,"encoder":109,"layer":99,"keys":110,"name":111,"range":31,"default":31,"cc":31,"cc_confidence":31,"note":112,"source":36,"firmware_min":31,"verified_on":31,"confidence":37},"E3","turn E3","range","span of the run",{"screen":20,"encoder":114,"layer":99,"keys":91,"name":115,"range":116,"default":31,"cc":31,"cc_confidence":31,"note":117,"source":36,"firmware_min":31,"verified_on":31,"confidence":37},"E4","hold","off / on","keeps the run going after the keys are released",{"screen":20,"encoder":98,"layer":119,"keys":120,"name":121,"range":31,"default":31,"cc":31,"cc_confidence":31,"note":31,"source":36,"firmware_min":31,"verified_on":31,"confidence":37},"shift","shift + turn E1","note length",{"screen":20,"encoder":104,"layer":119,"keys":123,"name":124,"range":31,"default":31,"cc":31,"cc_confidence":31,"note":125,"source":36,"firmware_min":31,"verified_on":31,"confidence":37},"shift + turn E2","style","playback order of the notes",{"screen":20,"encoder":109,"layer":119,"keys":127,"name":128,"range":31,"default":31,"cc":31,"cc_confidence":31,"note":129,"source":36,"firmware_min":31,"verified_on":31,"confidence":37},"shift + turn E3","glide","slide between notes",{"screen":20,"encoder":114,"layer":119,"keys":131,"name":132,"range":31,"default":31,"cc":31,"cc_confidence":31,"note":133,"source":36,"firmware_min":31,"verified_on":31,"confidence":37},"shift + turn E4","stereo","pans successive notes apart",[135,136,137],"players.overview","players.hold","basics.linked-tracks","The arpeggio steps through a chord, played live or sequenced, at the speed of `E1`, in the order of\n`E2`, across the span of `E3`; hold (`E4`) keeps it going hands-free. The shift layer adds note\nlength, style, glide and stereo spread. Since the guide, arpeggios ignore the sustain pedal and\nfollow the brain (1.1.17), and a pattern change cuts held notes (1.1.21).",[140,142,144,145,146,147,149,150],{"url":36,"kind":141},"guide",{"url":44,"kind":143},"changelog",{"url":48,"kind":143},{"url":52,"kind":143},{"url":59,"kind":143},{"url":63,"kind":148},"research",{"url":72,"kind":148},{"url":80,"kind":148},[152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167,168,169,170,171,172,173,174,175,176,177,178,179,180],"encoder.4","keyboard.f3","keyboard.fs3","keyboard.g3","keyboard.gs3","keyboard.a3","keyboard.as3","keyboard.b3","keyboard.c4","keyboard.cs4","keyboard.d4","keyboard.ds4","keyboard.e4","keyboard.f4","keyboard.fs4","keyboard.g4","keyboard.gs4","keyboard.a4","keyboard.as4","keyboard.b4","keyboard.c5","keyboard.cs5","keyboard.d5","keyboard.ds5","keyboard.e5","encoder.1","encoder.2","encoder.3","key.shift",{"id":12,"title":182},"Players",{"id":135,"title":182},{"id":185,"title":186},"players.maestro","Maestro player",{"basics.key-notation":188,"basics.main-modes":189,"basics.modules":190,"basics.track-buttons":191,"basics.linked-tracks":192,"basics.patterns-scenes-songs":193,"basics.workflow":194,"basics.firmware-versions":195,"hardware.layout":196,"hardware.power-and-charging":197,"hardware.connectors":198,"hardware.specifications":199,"hardware.te-boot":200,"hardware.firmware-update":201,"hardware.factory-reset":202,"hardware.system-menu":203,"hardware.safety-and-care":204,"hardware.in-the-box":205,"sequencer.overview":206,"sequencer.step-entry":207,"sequencer.step-recording":208,"sequencer.live-recording":209,"sequencer.extend-notes":210,"sequencer.nudge":211,"sequencer.single-sound":212,"sequencer.rotate":213,"sequencer.copy-step":214,"sequencer.transpose-sequence":215,"sequencer.parameter-locks":216,"sequencer.clear-and-undo":217,"sequencer.step-components":218,"se