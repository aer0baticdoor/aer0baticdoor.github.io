{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,30,64,161,176,276,307,338,363,388,410,438,448,491],{"id":3,"title":4,"units":5},"basics","Basics",[6,9,12,15,18,21,24,27],{"id":7,"title":8},"basics.key-notation","How key presses are written",{"id":10,"title":11},"basics.main-modes","Main modes",{"id":13,"title":14},"basics.modules","Module pages (M1–M4)",{"id":16,"title":17},"basics.track-buttons","Track keys and the active track",{"id":19,"title":20},"basics.linked-tracks","Linking tracks",{"id":22,"title":23},"basics.patterns-scenes-songs","Patterns, scenes, songs and projects",{"id":25,"title":26},"basics.workflow","From first notes to a song",{"id":28,"title":29},"basics.firmware-versions","Firmware versions and this manual",{"id":31,"title":32,"units":33},"hardware","Hardware",[34,37,40,43,46,49,52,55,58,61],{"id":35,"title":36},"hardware.layout","Panel layout",{"id":38,"title":39},"hardware.power-and-charging","Power, battery and charging",{"id":41,"title":42},"hardware.connectors","Connectors and jacks",{"id":44,"title":45},"hardware.specifications","Technical specifications",{"id":47,"title":48},"hardware.te-boot","TE boot (bootloader menu)",{"id":50,"title":51},"hardware.firmware-update","Updating the OS",{"id":53,"title":54},"hardware.factory-reset","Factory reset",{"id":56,"title":57},"hardware.system-menu","Function test and pot calibration (system menu)",{"id":59,"title":60},"hardware.safety-and-care","Safety, care and warranty",{"id":62,"title":63},"hardware.in-the-box","Box contents and the factory-sound licence",{"id":65,"title":66,"units":67},"sequencer","Sequencer",[68,71,74,77,80,83,86,89,92,95,98,101,104,107,110,113,116,119,122,125,128,131,134,137,140,143,146,149,152,155,158],{"id":69,"title":70},"sequencer.overview","Step sequencer overview",{"id":72,"title":73},"sequencer.step-entry","Entering notes on steps",{"id":75,"title":76},"sequencer.step-recording","Step recording",{"id":78,"title":79},"sequencer.live-recording","Live re