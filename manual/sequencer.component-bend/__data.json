e; spring out swings up first over two cycles that fade (about +87, −83, +66, −59 cents) and spring in is the same growing; fade down is a straight line to about −85 cents at the end. Random 1 and 2 are single sightings, scaled the same.","docs/research/78-overnight-accuracy.md#log","community",[44],{"id":45,"goal":46,"preconditions":47,"steps":48,"result":22,"source":51,"firmware_min":22,"verified_on":22,"confidence":28},"add","Give a step a dip-and-return bend",[],[49],{"keys":50,"note":22,"set":22},"shift + steps → + natural 9 → + accidental 1","https://teenage.engineering/guides/op-xy/step-components#adding-step-components-to-a-sequence",[],[54,55],"instrument.play-mode","sequencer.step-component-reference","A small pitch envelope for one step: dips, falling kicks, chirps on percussion.",[58,60,61,62,64],{"url":27,"kind":59},"guide",{"url":32,"kind":59},{"url":36,"kind":59},{"url":41,"kind":63},"research",{"url":51,"kind":59},[66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84],"key.shift","step.1","step.2","step.3","step.4","step.5","step.6","step.7","step.8","step.9","step.10","step.11","step.12","step.13","step.14","step.15","step.16","keyboard.g4","keyboard.fs3",{"id":8,"title":86},"Sequencer",{"id":88,"title":89},"sequencer.component-portamento","Portamento (step component)",{"id":91,"title":92},"sequencer.component-tonality","Tonality (step component)",{"basics.key-notation":94,"basics.main-modes":95,"basics.modules":96,"basics.track-buttons":97,"basics.linked-tracks":98,"basics.patterns-scenes-songs":99,"basics.workflow":100,"basics.firmware-versions":101,"hardware.layout":102,"hardware.power-and-charging":103,"hardware.connectors":104,"hardware.specifications":105,"hardware.te-boot":106,"hardware.firmware-update":107,"hardware.factory-reset":108,"hardware.system-menu":109,"hardware.safety-and-care":110,"hardware.in-the-box":111,"sequencer.overview":112,"sequencer.step-entry":113,"sequencer.step-recording":114,"sequencer.live-recording":115,"sequenc