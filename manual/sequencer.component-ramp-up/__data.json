ta","data":[{"unit":1,"title":3,"area":82,"prev":84,"next":87,"titles":89,"firmware":258},{"id":2,"title":3,"aliases":4,"area":8,"order":9,"path":10,"context":11,"summary":16,"status":17,"firmware":18,"facts":23,"procedures":41,"parameters":50,"related":51,"body":54,"sources":55,"official_url":27,"controls":62},"sequencer.component-ramp-up","Ramp up (step component)",[5,6,7],"ramp up","rising ramp","climbing step","sequencer",46,"knowledge/manual/units/sequencer/component-ramp-up.md",{"modes":12,"screens":15},[13,14],"instrument","auxiliary",[],"Step component on `natural 5` whose note climbs one stage of an in-scale ramp each time the step plays.","current",{"min":19,"changed_in":20,"guide_version":21,"verified_on":22},"1.0.9",[],"1.1.15",null,[24,29,33,38],{"id":25,"text":26,"source":27,"firmware_min":22,"verified_on":22,"confidence":28},"what","Each time the step plays, ramp up moves its note one stage higher along a ramp that stays inside the current scale.","https://teenage.engineering/guides/op-xy/step-components","official",{"id":30,"text":31,"source":32,"firmware_min":22,"verified_on":22,"confidence":28},"values","The black keys 1–5 give a ramp of 2–6 steps within one octave; 6–9 and 0 give 2–6 steps over three octaves, so 0 is the widest ramp rather than random.","https://teenage.engineering/guides/op-xy/step-components#step-components-ref-table",{"id":34,"text":35,"source":36,"firmware_min":22,"verified_on":22,"confidence":37},"sets","The stages are the scale's own degrees, not an even spread. Two steps are the note and its octave; three add the fifth; four add the third (1 3 5 8); five the fourth (1 3 4 5 8); six the seventh (1 3 4 5 7 8). The three-octave settings repeat that set in each octave. Heard on an OP-Z, whose components and table match, over C mixolydian - ramp up 5 played C E F G B-flat C, one note a bar.","https://youtu.be/NqiuiHluGOY","community",{"id":39,"text":40,"source":36,"firmware_min":22,"verified_on":22,"confidence":37},"per-trigger","The ramp moves on at every trigger of the step, so a pulse repeat or a multiply hit takes the next stage; it starts over after the top (C G C' C G C') and is not tied to the pattern pass.",[42],{"id":43,"goal":44,"preconditions":45,"steps":46,"result":22,"source":49,"firmware_min":22,"verified_on":22,"confidence":28},"add","Make a step climb in four stages through an octave",[],[47],{"keys":48,"note":22,"set":22},"shift + steps → + natural 5 → + accidental 3","https://teenage.engineering/guides/op-xy/step-components#adding-step-components-to-a-sequence",[],[52,53],"sequencer.component-ramp-down","sequencer.step-component-reference","One repeated note becomes a figure that rises from pass to pass, such as a bass note climbing each\ntime the loop comes round.",[56,58,59,61],{"url":27,"kind":57},"guide",{"url":32,"kind":57},{"url":36,"kind":60},"web",{"url":49,"kind":57},[63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81],"key.shift","step.1","step.2","step.3","step.4","step.5","step.6","step.7","step.8","step.9","step.10","step.11","step.12","step.13","step.14","step.15","step.16","keyboard.c4","keyboard.as3",{"id":8,"title":83},"Sequencer",{"id":85,"title":86},"sequencer.component-velocity","Velocity (step component)",{"id":52,"title":88},"Ramp down (step component)",{"basics.key-notation":90,"basics.main-modes":91,"basics.modules":92,"basics.track-buttons":93,"basics.linked-tracks":94,"basics.patterns-scenes-songs":95,"basics.workflow":96,"basics.firmware-versions":97,"hardware.layout":98,"hardware.power-and-charging":99,"hardware.connectors":100,"hardware.specifications":101,"hardware.te-boot":102,"hardware.firmware-update":103,"hardware.factory-reset":104,"hardware.system-menu":105,"hardware.safety-and-care":106,"hardware.in-the-box":107,"sequencer.overview":108,"sequencer.step-entry":109,"sequencer.step-recording":110,"sequencer.live-recording":111,"sequencer.extend-notes":112,"sequencer.nudge":113,"sequencer.single-sound":114,"sequencer.rotate":115,"seq