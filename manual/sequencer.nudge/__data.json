ta","data":[{"unit":1,"title":3,"area":84,"prev":86,"next":89,"titles":92,"firmware":261},{"id":2,"title":3,"aliases":4,"area":11,"order":12,"path":13,"context":14,"summary":19,"status":20,"firmware":21,"facts":26,"procedures":47,"parameters":55,"related":56,"body":59,"sources":60,"official_url":30,"controls":65},"sequencer.nudge","Nudging steps off the grid",[5,6,7,8,9,10],"nudge","micro timing","microtiming","off-grid","late note","early note","sequencer",22,"knowledge/manual/units/sequencer/nudge.md",{"modes":15,"screens":18},[16,17],"instrument","auxiliary",[],"Hold a step and press `[-]` or `[+]` to move its notes slightly earlier or later; this needs the track's quantisation below 100.","current",{"min":22,"changed_in":23,"guide_version":24,"verified_on":25},"1.0.9",[],"1.1.15",null,[27,32,35,38,42],{"id":28,"text":29,"source":30,"firmware_min":25,"verified_on":25,"confidence":31},"how","Holding a step and pressing `[-]` or `[+]` moves the step's notes earlier or later, off the step grid.","https://teenage.engineering/guides/op-xy/sequencer#step-sequencing","official",{"id":33,"text":34,"source":30,"firmware_min":25,"verified_on":25,"confidence":31},"speed","Each press is a fine adjustment; keeping `[-]` or `[+]` held moves faster.",{"id":36,"text":37,"source":30,"firmware_min":25,"verified_on":25,"confidence":31},"quantise-rule","Nudging only works while the track's quantisation (`bar + turn E1`) is below 100.",{"id":39,"text":40,"source":30,"firmware_min":25,"verified_on":25,"confidence":41},"quantise-at-playback","Since a nudged note keeps its offset under quantisation below 100, quantisation most likely acts as notes play rather than when they are recorded, so lowering it after a take lets the take's own timing back in. Not checked on a unit.","derived",{"id":43,"text":44,"source":45,"firmware_min":25,"verified_on":25,"confidence":46},"quantise-default","Decoded project files show quantisation at 100 in a new project, so turn it down before nudging.","docs/research/10-xy-format.md#34-patternstruct-base-clones-walking","community-verified",[48],{"id":5,"goal":49,"preconditions":50,"steps":52,"result":25,"source":30,"firmware_min":25,"verified_on":25,"confidence":31},"Move a step's notes slightly off the grid",[51],"the track's quantisation is below 100",[53],{"keys":54,"note":25,"set":25},"step n + [-]/[+]",[],[57,58],"sequencer.bar-menu","sequencer.rotate","If `[-]` and `[+]` seem to do nothing while a step is held, quantisation is at 100. For the feel of a\nwhole track rather than single steps, use groove instead.",[61,63],{"url":30,"kind":62},"guide",{"url":45,"kind":64},"research",[66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83],"step.1","step.2","step.3","step.4","step.5","step.6","step.7","step.8","step.9","step.10","step.11","step.12","step.13","step.14","step.15","step.16","key.minus","key.plus",{"id":11,"title":85},"Sequencer",{"id":87,"title":88},"sequencer.extend-notes","Extended notes and note length",{"id":90,"title":91},"sequencer.single-sound","Sequencing one sound at a time",{"basics.key-notation":93,"basics.main-modes":94,"basics.modules":95,"basics.track-buttons":96,"basics.linked-tracks":97,"basics.patterns-scenes-songs":98,"basics.workflow":99,"basics.firmware-versions":100,"hardware.layout":101,"hardware.power-and-charging":102,"hardware.connectors":103,"hardware.specifications":104,"hardware.te-boot":105,"hardware.firmware-update":106,"hardware.factory-reset":107,"hardware.system-menu":108,"hardware.safety-and-care":109,"hardware.in-the-box":110,"sequencer.overview":111,"sequencer.step-entry":112,"sequencer.step-recording":113,"sequencer.live-recording":114,"sequencer.extend-notes":88,"sequencer.nudge":3,"sequencer.single-sound":91,"sequencer.rotate":115,"sequencer.copy-step":116,"sequencer.transpose-sequence":117,"sequencer.parameter-locks":118,"sequencer.clear-and-undo":119,"sequencer.step-components":120,"sequencer.step-component-reference":121,"sequencer.component-pulse":122,"sequencer