ta","data":[{"unit":1,"title":3,"area":85,"prev":87,"next":89,"titles":92,"firmware":261},{"id":2,"title":3,"aliases":4,"area":9,"order":10,"path":11,"context":12,"summary":17,"status":18,"firmware":19,"facts":24,"procedures":72,"parameters":73,"related":74,"body":76,"sources":77,"official_url":28,"controls":84},"sequencer.step-component-reference","Step component values",[5,6,7,8],"step component table","component values","accidental values","what the number keys do","sequencer",41,"knowledge/manual/units/sequencer/step-component-reference.md",{"modes":13,"screens":16},[14,15],"instrument","auxiliary",[],"What each black key (1–9, then 0) selects for each of the 14 step components, in white-key order.","current",{"min":20,"changed_in":21,"guide_version":22,"verified_on":23},"1.0.9",[],"1.1.15",null,[25,30,33,36,39,42,45,48,51,54,57,62,67],{"id":26,"text":27,"source":28,"firmware_min":23,"verified_on":23,"confidence":29},"pulse","Pulse (`natural 1`): 1–9 repeats; 0 a random number.","https://teenage.engineering/guides/op-xy/step-components#step-components-ref-table","official",{"id":31,"text":32,"source":28,"firmware_min":23,"verified_on":23,"confidence":29},"pulse-hold","Pulse hold (`natural 2`): held for 1–9 steps; 0 a random number.",{"id":34,"text":35,"source":28,"firmware_min":23,"verified_on":23,"confidence":29},"multiply","Multiply (`natural 3`): 1–8 hits inside the step; 0 a random number; for 9 see the multiply unit.",{"id":37,"text":38,"source":28,"firmware_min":23,"verified_on":23,"confidence":29},"velocity","Velocity (`natural 4`): 1–8 give 4, 8, 16, 32, 64, 100, 112, 127; 9 gives 0; 0 a random velocity.",{"id":40,"text":41,"source":28,"firmware_min":23,"verified_on":23,"confidence":29},"ramps-random","Ramp up (`natural 5`), ramp down (`natural 6`) and random (`natural 7`): 1–5 mean 2–6 steps within one octave; 6–9 and 0 mean 2–6 steps over three octaves.",{"id":43,"text":44,"source":28,"firmware_min":23,"verified_on":23,"confidence":29},"portamento","Portamento (`natural 8`): 1–9 give 10–90%; 0 a random amount.",{"id":46,"text":47,"source":28,"firmware_min":23,"verified_on":23,"confidence":29},"bend","Bend (`natural 9`): 1 down-up, 2 up-down, 3 bump down, 4 bump up, 5 spring out, 6 spring in, 7 fade down, 8 fade up, 9 random 1, 0 random 2.",{"id":49,"text":50,"source":28,"firmware_min":23,"verified_on":23,"confidence":29},"tonality","Tonality (`natural 10`): 1 ignore chord progression, 2 transpose only, 3 octave up, 4 fifth up, 5 third up, 6 chromatic up, 7 chromatic down, 8/9/0 quantize 33/66/100%.",{"id":52,"text":53,"source":28,"firmware_min":23,"verified_on":23,"confidence":29},"jump","Jump (`natural 11`): 1–4 go to step 1, 5, 9 or 13; 5 one forward; 6 one back; 7 forward or back; 8 stay; 9 align the track position; 0 a random step.",{"id":55,"text":56,"source":28,"firmware_min":23,"verified_on":23,"confidence":29},"skips","Skip parameter lock (`natural 12`), skip step component (`natural 13`) and skip trigger (`natural 14`): 1 every pass, 2–9 every 2nd to 9th pass, 0 at random.",{"id":58,"text":59,"source":60,"firmware_min":23,"verified_on":23,"confidence":61},"defaults","Added without a digit, a component keeps a default value; decoded device files show 4 for most, 2 for multiply and the skips, 5 for velocity and 1 for bend.","docs/research/10-xy-format.md#38-step-components-16-b-per-step-64-steps-at-0x3057","community",{"id":63,"text":64,"source":65,"firmware_min":23,"verified_on":23,"confidence":66},"scale","The ramps and random stay in the current scale, presumably the song scale set on the brain track.","https://teenage.engineering/guides/op-xy/auxiliary#brain","derived",{"id":68,"text":69,"source":70,"firmware_min":23,"verified_on":23,"confidence":71},"icons","Key icons from `natural 1` to `natural 14`: four dots, open hand, ÷, rising wedge, stairs up, stairs down, \"rnd\", glide sign, twin fins, four-petal fan, arrow to a dot, spoked wheel, ring of wedges, sun.","docs/research/50-hardware-ui.md#25-octa